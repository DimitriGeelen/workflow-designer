<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_git-commit-flow"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_git-commit-flow">
    <bpmn:participant id="Pool_git_commit_flow" name="git-commit-flow" processRef="Process_git-commit-flow"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_git-commit-flow" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="git-commit-flow" version="1" schemaVersion="2" title="git-commit-flow" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="140"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>hum_1_authorise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hum_2_reminder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="340"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_6_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_1_blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_2_git</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_4_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_3_git</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_5_pre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="150"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_git</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_parse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_3_bypass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_4_xxx</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_git" name="git.sh commit -m &quot;T-XXX: …&quot;">
      <bpmn:extensionElements>
        <aef:uid value="n_start"/>
        <aef:position x="90.0" y="636.5"/>
        <aef:meta triggeredBy="agent (or fw git commit) — commit.sh:do_commit"/>
        <aef:io>
          <aef:output name="message" type="string"/>
          <aef:output name="task_id" type="string"/>
          <aef:output name="bypass" type="boolean"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="frw_6_commit" name="commit recorded (task stamped)">
      <bpmn:extensionElements>
        <aef:uid value="n_done"/>
        <aef:position x="830.0" y="481.5"/>
        <aef:meta terminalKind="success" state="committed"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:incoming>flow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_1_blocked" name="BLOCKED — no ref / hook hit / no reason">
      <bpmn:extensionElements>
        <aef:uid value="n_block"/>
        <aef:position x="400.0" y="481.5"/>
        <aef:meta terminalKind="error" state="blocked" note="sources — g_taskref no-ref (P-002), g_hooks blocked (secret/dup/large/msg), n_reason no-reason" exitCode="1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:incoming>flow_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="frw_2_git" name="git commit (bypass) — still fires hooks">
      <bpmn:extensionElements>
        <aef:uid value="n_commit_bypass"/>
        <aef:position x="440.0" y="297.5"/>
        <aef:meta tier="1"/>
        <aef:endpoint>commit.sh:78-79 (git commit -m … ; NO --no-verify)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="frw_4_log" name="log_bypass_entry → .context/bypass-log.yaml">
      <bpmn:extensionElements>
        <aef:uid value="n_logbypass"/>
        <aef:position x="600.0" y="297.5"/>
        <aef:meta tier="1"/>
        <aef:endpoint>bypass.sh:76-113 (log_bypass_entry)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="frw_3_git" name="git commit (triggers hooks)">
      <bpmn:extensionElements>
        <aef:uid value="n_commit"/>
        <aef:position x="520.0" y="467.5"/>
        <aef:meta tier="1"/>
        <aef:endpoint>commit.sh:113 (git commit -m … "${git_args[@]}")</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="hum_1_authorise" name="authorise bypass — reason required (Tier-2)">
      <bpmn:extensionElements>
        <aef:uid value="n_reason"/>
        <aef:position x="300.0" y="100.0"/>
        <aef:meta tier="2" note="single-use situational authorisation; the human owns the reason" guard="no reason → ERROR exit 1 (bypass needs a reason)"/>
        <aef:endpoint>commit.sh:67-76 (prompt if empty; empty → ERROR exit 1)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="hum_2_reminder" name="reminder: create retroactive task">
      <bpmn:extensionElements>
        <aef:uid value="n_reminder"/>
        <aef:position x="760.0" y="100.0"/>
        <aef:meta note="advisory nudge — not structurally enforced (bypass leaves a task-debt)"/>
        <aef:endpoint>commit.sh:83-85 (REMINDER: create-task.sh)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:scriptTask id="agt_2_parse" name="parse args; check_git_repo; require -m">
      <bpmn:extensionElements>
        <aef:uid value="n_parse"/>
        <aef:position x="150.0" y="622.5"/>
        <aef:meta tier="1" guard="empty message → ERROR exit 1 (blocks before any branch)"/>
        <aef:endpoint>commit.sh:8-64 (arg loop + check_git_repo + message-required)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="agt_3_bypass" name="--bypass?">
      <bpmn:extensionElements>
        <aef:uid value="g_bypass"/>
        <aef:position x="300.0" y="630.5"/>
        <aef:meta decisionOwner="agent"/>
        <aef:endpoint>commit.sh:66 ($bypass == true)</aef:endpoint>
        <aef:decisionInput>${bypass}</aef:decisionInput>
        <aef:decisionOutputs>bypass, enforce</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="agt_4_xxx" name="T-XXX in message? (P-002, agent-level)">
      <bpmn:extensionElements>
        <aef:uid value="g_taskref"/>
        <aef:position x="410.0" y="630.5"/>
        <aef:meta decisionOwner="framework"/>
        <aef:endpoint>commit.sh:96-110 (found_task=extract_task_id "$message")</aef:endpoint>
        <aef:decisionInput>${extract_task_id(message) != ""}</aef:decisionInput>
        <aef:decisionOutputs>has-ref, no-ref</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="frw_5_pre" name="pre-commit + commit-msg hooks pass?">
      <bpmn:extensionElements>
        <aef:uid value="g_hooks"/>
        <aef:position x="680.0" y="475.5"/>
        <aef:meta decisionOwner="framework"/>
        <aef:endpoint>hooks.sh:271-358 (pre-commit) + hooks.sh:55-88 (commit-msg)</aef:endpoint>
        <aef:decisionInput>${all_hook_gates_pass}</aef:decisionInput>
        <aef:decisionOutputs>pass, blocked</aef:decisionOutputs>
        <aef:constituents>
          <aef:constituent id="c_secret" name="secret-scan" ref="T-1844"/>
          <aef:constituent id="c_duptask" name="dup-task-scan" ref="G-052"/>
          <aef:constituent id="c_largefile" name="large-file scan" ref="T-1845"/>
          <aef:constituent id="c_taskref" name="commit-msg task-ref check" ref="hooks.sh v1.9"/>
        </aef:constituents>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_1_git" targetRef="agt_2_parse">
      <bpmn:extensionElements>
        <aef:uid value="e1"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" sourceRef="agt_2_parse" targetRef="agt_3_bypass">
      <bpmn:extensionElements>
        <aef:uid value="e2"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="--bypass" sourceRef="agt_3_bypass" targetRef="hum_1_authorise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">bypass == true</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e3"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" name="enforce" sourceRef="agt_3_bypass" targetRef="agt_4_xxx">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">bypass == false</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e4"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" name="reason given" sourceRef="hum_1_authorise" targetRef="frw_2_git">
      <bpmn:extensionElements>
        <aef:uid value="e5"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" sourceRef="frw_2_git" targetRef="frw_4_log">
      <bpmn:extensionElements>
        <aef:uid value="e6"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" sourceRef="frw_4_log" targetRef="hum_2_reminder">
      <bpmn:extensionElements>
        <aef:uid value="e7"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" sourceRef="hum_2_reminder" targetRef="frw_6_commit">
      <bpmn:extensionElements>
        <aef:uid value="e8"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" name="has ref" sourceRef="agt_4_xxx" targetRef="frw_3_git">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">found_task != ''</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e9"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" name="no ref (P-002 block)" sourceRef="agt_4_xxx" targetRef="frw_1_blocked">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">found_task == ''</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e10"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_11" sourceRef="frw_3_git" targetRef="frw_5_pre">
      <bpmn:extensionElements>
        <aef:uid value="e11"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_12" name="pass" sourceRef="frw_5_pre" targetRef="frw_6_commit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">all_hook_gates_pass</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e12"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_13" name="blocked" sourceRef="frw_5_pre" targetRef="frw_1_blocked">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!all_hook_gates_pass</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e13"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>