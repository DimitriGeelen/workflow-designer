<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_context-memory"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_context-memory">
    <bpmn:participant id="Pool_context_memory" name="context-memory" processRef="Process_context-memory"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_context-memory" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="context-memory" uuid="81883506-c8d2-45b1-a767-9ed733df94e4" version="1" schemaVersion="2" title="context-memory" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="working" name="Working Memory · session-local">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="wrk" authority="none" height="96"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>wrk_1_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wrk_2_context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wrk_3_context</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="project" name="Project Memory · durable cross-task">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="prj" authority="none" height="264"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>prj_6_project</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prj_1_add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prj_3_add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prj_4_add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prj_5_promote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prj_2_capture</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="episodic" name="Episodic Memory · completed histories">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="epi" authority="none" height="96"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>epi_1_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>epi_3_episodic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>epi_2_generate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="wrk_1_session" name="Session start">
      <bpmn:extensionElements>
        <aef:uid value="n_start"/>
        <aef:position x="121.6" y="92.0"/>
        <aef:meta triggeredBy="fw context init (session start)"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="epi_1_task" name="task work-completed (P-011 passed)">
      <bpmn:extensionElements>
        <aef:uid value="n_complete"/>
        <aef:position x="136.7" y="452.0"/>
        <aef:meta triggeredBy="update-task.sh:1254 / 1980 (auto on --status work-completed)"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="prj_6_project" name="project memory durable (survives session)">
      <bpmn:extensionElements>
        <aef:uid value="n_persisted"/>
        <aef:position x="1086.6" y="272.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:incoming>flow_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="epi_3_episodic" name="episodic stored — feeds future recall">
      <bpmn:extensionElements>
        <aef:uid value="n_stored"/>
        <aef:position x="716.4" y="452.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="wrk_2_context" name="context init — seed session + focus + counters">
      <bpmn:extensionElements>
        <aef:uid value="n_init"/>
        <aef:position x="229.3" y="78.0"/>
        <aef:meta agentType="framework"/>
        <aef:endpoint>lib/init.sh:26-77</aef:endpoint>
        <aef:artifactsWrites paths=".context/working/session.yaml, .context/working/focus.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="wrk_3_context" name="context focus T-XXX — set current_task + recall briefing">
      <bpmn:extensionElements>
        <aef:uid value="n_focus"/>
        <aef:position x="412.8" y="78.0"/>
        <aef:endpoint>lib/focus.sh:49-127</aef:endpoint>
        <aef:contextReads paths=".context/project/learnings.yaml, .context/project/patterns.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="prj_1_add" name="add-learning -&gt; learnings.yaml">
      <bpmn:extensionElements>
        <aef:uid value="n_learning"/>
        <aef:position x="509.8" y="346.0"/>
        <aef:meta agentType="any"/>
        <aef:endpoint>lib/learning.sh:91-126</aef:endpoint>
        <aef:artifactsWrites paths=".context/project/learnings.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="prj_3_add" name="add-pattern &lt;failure|success|workflow&gt; -&gt; patterns.yaml">
      <bpmn:extensionElements>
        <aef:uid value="n_pattern"/>
        <aef:position x="782.7" y="258.0"/>
        <aef:meta agentType="any"/>
        <aef:endpoint>lib/pattern.sh:124-157</aef:endpoint>
        <aef:artifactsWrites paths=".context/project/patterns.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="prj_4_add" name="add-decision -&gt; decisions.yaml">
      <bpmn:extensionElements>
        <aef:uid value="n_decision"/>
        <aef:position x="1049.6" y="170.0"/>
        <aef:meta agentType="any"/>
        <aef:endpoint>lib/decision.sh:103-147</aef:endpoint>
        <aef:artifactsWrites paths=".context/project/decisions.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="prj_5_promote" name="promote L-&gt;practice-&gt;directive (3+ applications)">
      <bpmn:extensionElements>
        <aef:uid value="n_promote"/>
        <aef:position x="1049.6" y="346.0"/>
        <aef:endpoint>lib/promote.sh:4-5 (fw promote); cross-project lib/harvest.sh</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:scriptTask id="epi_2_generate" name="generate-episodic — task file + git log -&gt; episodic/T-XXX.yaml">
      <bpmn:extensionElements>
        <aef:uid value="n_episodic"/>
        <aef:position x="389.5" y="438.0"/>
        <aef:meta agentType="framework"/>
        <aef:endpoint>lib/episodic.sh:242-441</aef:endpoint>
        <aef:contextReads paths=".tasks/completed/${task_id}.md, git log --grep ^${task_id}"/>
        <aef:artifactsWrites paths=".context/episodic/${task_id}.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="prj_2_capture" name="capture what? (agent judgement)">
      <bpmn:extensionElements>
        <aef:uid value="g_capture"/>
        <aef:position x="540.8" y="266.0"/>
        <aef:meta decisionOwner="agent"/>
        <aef:decisionInput>${knowledge_kind}</aef:decisionInput>
        <aef:decisionOutputs>learning, pattern, decision</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="flow_1" sourceRef="wrk_1_session" targetRef="wrk_2_context">
      <bpmn:extensionElements>
        <aef:uid value="e_01"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" sourceRef="wrk_2_context" targetRef="wrk_3_context">
      <bpmn:extensionElements>
        <aef:uid value="e_02"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="agent captures knowledge during work" sourceRef="wrk_3_context" targetRef="prj_2_capture">
      <bpmn:extensionElements>
        <aef:uid value="e_03"/>
        <aef:anchors targetPort="W"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" name="learning" sourceRef="prj_2_capture" targetRef="prj_1_add">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${kind == 'learning'}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_04"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" name="pattern (failure/success/workflow)" sourceRef="prj_2_capture" targetRef="prj_3_add">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${kind == 'pattern'}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_05"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" name="decision" sourceRef="prj_2_capture" targetRef="prj_4_add">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${kind == 'decision'}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_06"/>
        <aef:anchors sourcePort="N"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" name="3+ applications -&gt; graduate" sourceRef="prj_1_add" targetRef="prj_5_promote">
      <bpmn:extensionElements>
        <aef:uid value="e_07"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" sourceRef="prj_3_add" targetRef="prj_6_project">
      <bpmn:extensionElements>
        <aef:uid value="e_08"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" sourceRef="prj_4_add" targetRef="prj_6_project">
      <bpmn:extensionElements>
        <aef:uid value="e_09"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" sourceRef="prj_5_promote" targetRef="prj_6_project">
      <bpmn:extensionElements>
        <aef:uid value="e_10"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_11" name="framework auto-fires" sourceRef="epi_1_task" targetRef="epi_2_generate">
      <bpmn:extensionElements>
        <aef:uid value="e_11"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_12" sourceRef="epi_2_generate" targetRef="epi_3_episodic">
      <bpmn:extensionElements>
        <aef:uid value="e_12"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>