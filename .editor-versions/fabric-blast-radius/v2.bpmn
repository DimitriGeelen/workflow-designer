<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_fabric-blast-radius"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_fabric-blast-radius">
    <bpmn:participant id="Pool_fabric_blast_radius" name="fabric-blast-radius" processRef="Process_fabric-blast-radius"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_fabric-blast-radius" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="fabric-blast-radius" version="1" schemaVersion="2" title="fabric-blast-radius" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="140"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_fw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="400"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_3_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_9_impact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_1_git</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_4_for</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_7_quick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_6_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_8_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_2_any</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_5_fabric</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_fw" name="fw fabric blast-radius [ref]">
      <bpmn:extensionElements>
        <aef:uid value="n_start"/>
        <aef:position x="222.0" y="114.0"/>
        <aef:meta triggeredBy="agent, before committing (CLAUDE.md Component Fabric practice) or post-commit review"/>
        <aef:io>
          <aef:output name="ref" type="string"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="frw_3_no" name="no files changed (exit 0)">
      <bpmn:extensionElements>
        <aef:uid value="n_none"/>
        <aef:position x="431.2" y="462.0"/>
        <aef:meta terminalKind="success" state="no-op" exitCode="0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_9_impact" name="impact reported (advisory — exit 0 always)">
      <bpmn:extensionElements>
        <aef:uid value="n_done"/>
        <aef:position x="1422.0" y="334.0"/>
        <aef:meta terminalKind="success" state="reported" note="blast-radius never blocks — it informs the agent's commit decision" exitCode="0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:scriptTask id="frw_1_git" name="git diff-tree → changed files; commit msg header">
      <bpmn:extensionElements>
        <aef:uid value="n_diff"/>
        <aef:position x="201.0" y="320.0"/>
        <aef:meta tier="1"/>
        <aef:endpoint>traverse.sh:159-173 (diff-tree --name-only -r ref; log -1 %s)</aef:endpoint>
        <aef:contextReads paths="git object store (diff-tree, log)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_4_for" name="for each changed file: skip non-source, find fabric card">
      <bpmn:extensionElements>
        <aef:uid value="n_scan"/>
        <aef:position x="587.3" y="320.0"/>
        <aef:meta tier="1" note="body below drawn for ONE iteration — no scope construct bounds it (FC-15)"/>
        <aef:endpoint>traverse.sh:175-210 (while read file; case skip; card grep)</aef:endpoint>
        <aef:multiInstance over="${changed_files} (git diff-tree output)" mode="sequential" predicate="file not under .context/ .fabric/ .tasks/ (case skip, traverse.sh:178-180)" collects="impacted[]"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_7_quick" name="quick impact: card writes → targets; count component">
      <bpmn:extensionElements>
        <aef:uid value="n_writes"/>
        <aef:position x="945.0" y="220.0"/>
        <aef:meta tier="1"/>
        <aef:endpoint>traverse.sh:191-201 (depends_on type==writes → print targets)</aef:endpoint>
        <aef:contextReads paths=".fabric/components/*.yaml (matched card)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_6_report" name="report '(no fabric card)' — advisory gap">
      <bpmn:extensionElements>
        <aef:uid value="n_nocard"/>
        <aef:position x="945.0" y="320.0"/>
        <aef:meta note="unregistered file — drift signal (fw fabric drift finds these); never blocks" softFail="advisory"/>
        <aef:endpoint>traverse.sh:206-208</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_8_report" name="report: N registered component(s) changed">
      <bpmn:extensionElements>
        <aef:uid value="n_total"/>
        <aef:position x="1185.0" y="320.0"/>
        <aef:endpoint>traverse.sh:212-213</aef:endpoint>
        <aef:aggregation over="impacted[]" reduce="count" outputs="total_impact"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="frw_2_any" name="any files changed?">
      <bpmn:extensionElements>
        <aef:uid value="g_changed"/>
        <aef:position x="425.2" y="328.0"/>
        <aef:meta decisionOwner="framework"/>
        <aef:endpoint>traverse.sh:162-165</aef:endpoint>
        <aef:decisionInput>${changed_files != ""}</aef:decisionInput>
        <aef:decisionOutputs>changed, empty</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="frw_5_fabric" name="fabric card exists for file?">
      <bpmn:extensionElements>
        <aef:uid value="g_card"/>
        <aef:position x="776.0" y="328.0"/>
        <aef:meta decisionOwner="framework" note="the inner card scan is a NESTED loop, collapsed into this decision (FC-15)"/>
        <aef:endpoint>traverse.sh:183-187 (inner scan of components/*.yaml, grep ^location)</aef:endpoint>
        <aef:decisionInput>${any card with location == file}</aef:decisionInput>
        <aef:decisionOutputs>has-card, no-card</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_1_fw" targetRef="frw_1_git">
      <bpmn:extensionElements>
        <aef:uid value="e1"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" sourceRef="frw_1_git" targetRef="frw_2_any">
      <bpmn:extensionElements>
        <aef:uid value="e2"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="empty" sourceRef="frw_2_any" targetRef="frw_3_no">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">changed_files == ''</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e3"/>
        <aef:anchors sourcePort="SE"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" name="changed" sourceRef="frw_2_any" targetRef="frw_4_for">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">changed_files != ''</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e4"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" sourceRef="frw_4_for" targetRef="frw_5_fabric">
      <bpmn:extensionElements>
        <aef:uid value="e5"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" name="has card" sourceRef="frw_5_fabric" targetRef="frw_7_quick">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">card_found</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e6"/>
        <aef:routingHint role="seg_mid" offset="-50.1"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" name="no card" sourceRef="frw_5_fabric" targetRef="frw_6_report">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!card_found</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e7"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" sourceRef="frw_7_quick" targetRef="frw_8_report">
      <bpmn:extensionElements>
        <aef:uid value="e8"/>
        <aef:anchors targetPort="N"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" sourceRef="frw_6_report" targetRef="frw_8_report">
      <bpmn:extensionElements>
        <aef:uid value="e9"/>
        <aef:anchors sourcePort="S" targetPort="S"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" sourceRef="frw_8_report" targetRef="frw_9_impact">
      <bpmn:extensionElements>
        <aef:uid value="e10"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>