{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook pre-compact"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook post-compact-resume"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook post-compact-resume"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook post-compact-resume"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook block-plan-mode"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-active-task"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-human-ac-tick"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-active-completed-dup"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-arc-id"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-heredoc-cmd-sub"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-inception-decisions"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-inception-schema"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-onboarding-gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-tier0"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-bare-import"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-agent-dispatch"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-project-boundary"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook budget-gate"
          }
        ]
      },
      {
        "matcher": "TodoWrite|TaskCreate|TaskUpdate|TaskList|TaskGet",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook block-task-tools"
          }
        ]
      },
      {
        "matcher": "mcp__termlink__termlink_channel_post",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-rail-mcp-label"
          }
        ]
      },
      {
        "matcher": "mcp__termlink__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/832-Workflow-designer/tools/_t420-rail-attribution-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook checkpoint post-tool"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook error-watchdog"
          }
        ]
      },
      {
        "matcher": "Task|TaskOutput",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-dispatch"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook loop-detect"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-fabric-new-file"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook commit-cadence"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook check-settings-edit"
          },
          {
            "type": "command",
            "command": "/opt/832-Workflow-designer/tools/hooks/warn-uncontrolled-absence.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook audit-task-tools"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic-framework/bin/fw hook sidecar-inbox"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "EnterWorktree",
      "ExitWorktree",
      "Bash(git worktree:*)"
    ]
  }
}
