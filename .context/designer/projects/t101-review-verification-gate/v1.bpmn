<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_verification-gate"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_verification-gate">
    <bpmn:participant id="Pool_verification_gate" name="verification-gate" processRef="Process_verification-gate"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_verification-gate" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="verification-gate" version="1" schemaVersion="2" title="verification-gate" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="140"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>hum_1_authorise</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="320"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_12_completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_6_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_4_partial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_11_generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_5_011</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_9_write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_10_git</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_2_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_1_owner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_3_agent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_7_every</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_8_rca</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="150"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_fw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_fix</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_fw" name="fw task update --status work-completed">
      <bpmn:extensionElements>
        <aef:uid value="n_request"/>
        <aef:position x="130.7" y="573.0"/>
        <aef:meta triggeredBy="agent completes work, checks ACs + Verification section"/>
        <aef:io>
          <aef:output name="task_id" type="string"/>
          <aef:output name="skip_flags" type="string"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="frw_12_completed" name="Completed">
      <bpmn:extensionElements>
        <aef:uid value="n_done"/>
        <aef:position x="1468.0" y="330.6"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_16</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_6_block" name="Block — exit 1 (completion refused)">
      <bpmn:extensionElements>
        <aef:uid value="n_block"/>
        <aef:position x="691.2" y="450.7"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_4_partial" name="Partial-complete: stays active/, owner -&gt; human">
      <bpmn:extensionElements>
        <aef:uid value="n_partial"/>
        <aef:position x="514.3" y="450.7"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="frw_11_generate" name="Generate episodic + capture decisions">
      <bpmn:extensionElements>
        <aef:uid value="n_episodic"/>
        <aef:position x="1318.0" y="316.6"/>
        <aef:endpoint>update-task.sh:1907-1996 (context.sh generate-episodic)</aef:endpoint>
        <aef:artifactsWrites paths=".context/episodic/${task_id}.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_2_fix" name="Fix unchecked ACs / failing verify cmds, re-run">
      <bpmn:extensionElements>
        <aef:uid value="n_remediate"/>
        <aef:position x="654.2" y="559.0"/>
        <aef:meta agentType="coder"/>
        <aef:endpoint>check AC boxes / repair</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="hum_1_authorise" name="Authorise bypass: --force / --skip-* (+ reason)">
      <bpmn:extensionElements>
        <aef:uid value="n_authorise"/>
        <aef:position x="282.7" y="109.9"/>
        <aef:meta decisionOwner="human"/>
        <aef:endpoint>update-task.sh:1104-1117 (--force sets all SKIP_* flags)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:scriptTask id="frw_5_011" name="P-011: extract ## Verification, eval each cmd">
      <bpmn:extensionElements>
        <aef:uid value="n_verify"/>
        <aef:position x="654.2" y="316.6"/>
        <aef:meta tier="1"/>
        <aef:endpoint>update-task.sh:949-1027</aef:endpoint>
        <aef:contextReads paths=".tasks/active/${task_id}.md (## Verification section, sed 953-954)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_9_write" name="Write status: work-completed + date_finished">
      <bpmn:extensionElements>
        <aef:uid value="n_write"/>
        <aef:position x="1023.7" y="316.6"/>
        <aef:endpoint>update-task.sh:1494,1706</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_10_git" name="git mv active -&gt; completed/, horizon -&gt; null">
      <bpmn:extensionElements>
        <aef:uid value="n_finalize"/>
        <aef:position x="1170.0" y="316.6"/>
        <aef:endpoint>update-task.sh:1742-1782</aef:endpoint>
        <aef:artifactsWrites paths=".tasks/completed/${task_id}.md"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_2_log" name="log_gate_bypass -&gt; .gate-bypass-log.yaml">
      <bpmn:extensionElements>
        <aef:uid value="n_logbypass"/>
        <aef:position x="282.7" y="414.5"/>
        <aef:meta tier="2"/>
        <aef:endpoint>update-task.sh:35-54</aef:endpoint>
        <aef:artifactsWrites paths=".context/working/.gate-bypass-log.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="frw_1_owner" name="owner == human? (R-033)">
      <bpmn:extensionElements>
        <aef:uid value="g_sovereign"/>
        <aef:position x="124.7" y="324.6"/>
        <aef:meta decisionOwner="framework"/>
        <aef:endpoint>update-task.sh:1406-1408 (fn 58-75)</aef:endpoint>
        <aef:decisionInput>${task.owner}</aef:decisionInput>
        <aef:decisionOutputs>agent-owned, human-owned</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="frw_3_agent" name="Agent ACs all checked? (P-010)">
      <bpmn:extensionElements>
        <aef:uid value="g_ac"/>
        <aef:position x="508.3" y="324.6"/>
        <aef:meta decisionOwner="framework"/>
        <aef:endpoint>update-task.sh:1412-1413 (fn 80-190)</aef:endpoint>
        <aef:decisionInput>${agent_ac_unchecked == 0 &amp;&amp; !placeholder_acs}</aef:decisionInput>
        <aef:decisionOutputs>agent-acs-ok, agent-acs-unchecked, human-acs-remain</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="frw_7_every" name="every verify cmd exit 0?">
      <bpmn:extensionElements>
        <aef:uid value="g_verify"/>
        <aef:position x="838.1" y="338.0"/>
        <aef:meta decisionOwner="framework"/>
        <aef:endpoint>update-task.sh:1010-1026</aef:endpoint>
        <aef:decisionInput>${verify_fail == 0}</aef:decisionInput>
        <aef:decisionOutputs>all-pass, some-nonzero</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="frw_8_rca" name="RCA / evolution / inception gates pass?">
      <bpmn:extensionElements>
        <aef:uid value="g_gates"/>
        <aef:position x="928.3" y="338.0"/>
        <aef:meta decisionOwner="framework"/>
        <aef:endpoint>update-task.sh: RCA 1430-1431/319-398, evolution 1465-1466/681-734, inception 1450-1458 (collapsed)</aef:endpoint>
        <aef:decisionInput>${rca_ok &amp;&amp; evolution_ok &amp;&amp; inception_ok}</aef:decisionInput>
        <aef:decisionOutputs>gates-ok, gates-block</aef:decisionOutputs>
        <aef:constituents>
          <aef:constituent id="c_recommendation" name="recommendation block present" ref="T-1529"/>
          <aef:constituent id="c_rca" name="RCA substantive for bug-class" ref="G-019"/>
          <aef:constituent id="c_disposition" name="disposition recorded"/>
          <aef:constituent id="c_render_review" name="render-review" ref="P-013"/>
          <aef:constituent id="c_incep_decision" name="inception decision recorded"/>
          <aef:constituent id="c_incep_scope" name="inception scope-trace"/>
          <aef:constituent id="c_evolution" name="evolution section filled" ref="T-1718"/>
          <aef:constituent id="c_taskpair" name="task-pair" ref="P-012"/>
        </aef:constituents>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_1_fw" targetRef="frw_1_owner">
      <bpmn:extensionElements>
        <aef:uid value="e_01"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" name="agent-owned" sourceRef="frw_1_owner" targetRef="frw_3_agent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${owner != 'human'}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_02"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="human-owned (R-033)" sourceRef="frw_1_owner" targetRef="hum_1_authorise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${owner == 'human'}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_03"/>
        <aef:anchors targetPort="W"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" name="human authorises" sourceRef="hum_1_authorise" targetRef="frw_2_log">
      <bpmn:extensionElements>
        <aef:uid value="e_04"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" name="sovereignty bypassed (Tier-2)" sourceRef="frw_2_log" targetRef="frw_3_agent">
      <bpmn:extensionElements>
        <aef:uid value="e_05"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" name="agent ACs checked" sourceRef="frw_3_agent" targetRef="frw_5_011">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${agent_ac_unchecked == 0}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_06"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" name="agent ACs unchecked (P-010)" sourceRef="frw_3_agent" targetRef="frw_6_block">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${agent_ac_unchecked &gt; 0}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_07"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" name="only human ACs remain (T-193)" sourceRef="frw_3_agent" targetRef="frw_4_partial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${human_ac_unchecked &gt; 0}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_08"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" sourceRef="frw_5_011" targetRef="frw_7_every">
      <bpmn:extensionElements>
        <aef:uid value="e_09"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" name="all verify cmds exit 0" sourceRef="frw_7_every" targetRef="frw_8_rca">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${verify_fail == 0}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_10"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_11" name="a verify cmd exit != 0 (P-011)" sourceRef="frw_7_every" targetRef="frw_6_block">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${verify_fail &gt; 0}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_11"/>
        <aef:anchors sourcePort="SE"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_12" name="RCA/evolution/inception ok" sourceRef="frw_8_rca" targetRef="frw_9_write">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${gates_ok == true}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_12"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_13" name="bug-class RCA empty / evolution stub (G-019)" sourceRef="frw_8_rca" targetRef="frw_6_block">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${gates_ok == false}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_13"/>
        <aef:anchors sourcePort="SE"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_14" sourceRef="frw_9_write" targetRef="frw_10_git">
      <bpmn:extensionElements>
        <aef:uid value="e_14"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_15" sourceRef="frw_10_git" targetRef="frw_11_generate">
      <bpmn:extensionElements>
        <aef:uid value="e_15"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_16" sourceRef="frw_11_generate" targetRef="frw_12_completed">
      <bpmn:extensionElements>
        <aef:uid value="e_16"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_17" name="agent remediates" sourceRef="frw_6_block" targetRef="agt_2_fix">
      <bpmn:extensionElements>
        <aef:uid value="e_17"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_18" name="re-run" sourceRef="agt_2_fix" targetRef="agt_1_fw">
      <bpmn:extensionElements>
        <aef:uid value="e_18"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>