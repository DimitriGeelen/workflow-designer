<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_audit-process"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_audit-process">
    <bpmn:participant id="Pool_audit_process" name="audit-process" processRef="Process_audit-process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_audit-process" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="audit-process" uuid="ed141d1f-45bd-444e-b041-e0b644f9251f" version="1" schemaVersion="2" title="audit-process" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="80"/>
        </bpmn:extensionElements>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="529"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_13_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_11_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_10_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_2_compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_6_traceability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_4_enforcement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_5_learning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_3_discovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_8_aggregate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_12_push</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_9_worst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_1_fan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_7_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="96"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_audit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_audit" name="Audit requested">
      <bpmn:extensionElements>
        <aef:uid value="n_trigger"/>
        <aef:position x="120.0" y="701.0"/>
        <aef:meta triggeredBy="fw audit [--sections ...] | cron"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="frw_13_audit" name="Audit FAIL (exit 2)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_fail"/>
        <aef:position x="1620.0" y="256.3"/>
        <aef:meta exitCode="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_17</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_11_audit" name="Audit WARN (exit 1)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_warn"/>
        <aef:position x="1420.0" y="382.9"/>
        <aef:meta exitCode="1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_15</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_10_audit" name="Audit PASS (exit 0)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_pass"/>
        <aef:position x="1420.0" y="588.9"/>
        <aef:meta exitCode="0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_16</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:scriptTask id="frw_2_compliance" name="Compliance checks (task refs, gates, structure)">
      <bpmn:extensionElements>
        <aef:uid value="n_compliance"/>
        <aef:position x="560.0" y="212.9"/>
        <aef:meta section="compliance"/>
        <aef:emits>
          <aef:emit value="pass"/>
          <aef:emit value="warn"/>
          <aef:emit value="fail"/>
        </aef:emits>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_6_traceability" name="Traceability checks (commit ↔ task P-002)">
      <bpmn:extensionElements>
        <aef:uid value="n_traceability"/>
        <aef:position x="560.0" y="288.9"/>
        <aef:meta section="traceability"/>
        <aef:emits>
          <aef:emit value="pass"/>
          <aef:emit value="warn"/>
          <aef:emit value="fail"/>
        </aef:emits>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_4_enforcement" name="Enforcement checks (hooks, baseline, bypass log)">
      <bpmn:extensionElements>
        <aef:uid value="n_enforcement"/>
        <aef:position x="560.0" y="440.9"/>
        <aef:meta section="enforcement"/>
        <aef:emits>
          <aef:emit value="pass"/>
          <aef:emit value="warn"/>
          <aef:emit value="fail"/>
        </aef:emits>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_5_learning" name="Learning / episodic completeness checks">
      <bpmn:extensionElements>
        <aef:uid value="n_learning"/>
        <aef:position x="560.0" y="516.9"/>
        <aef:meta section="learning"/>
        <aef:emits>
          <aef:emit value="pass"/>
          <aef:emit value="warn"/>
          <aef:emit value="fail"/>
        </aef:emits>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_3_discovery" name="Discovery checks (D1–D9 trend scans)">
      <bpmn:extensionElements>
        <aef:uid value="n_discovery"/>
        <aef:position x="560.0" y="364.9"/>
        <aef:meta section="discovery"/>
        <aef:emits>
          <aef:emit value="pass"/>
          <aef:emit value="warn"/>
          <aef:emit value="fail"/>
        </aef:emits>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_8_aggregate" name="Aggregate findings → tally + audit record">
      <bpmn:extensionElements>
        <aef:uid value="n_aggregate"/>
        <aef:position x="1020.0" y="330.4"/>
        <aef:artifactsWrites paths="['.context/audits/${date}.yaml', 'LATEST-CRON.yaml']"/>
        <aef:aggregation over="FINDINGS[]" reduce="severity-max" outputs="PASS_COUNT, WARN_COUNT, FAIL_COUNT"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_12_push" name="Push failure notification (T-709)">
      <bpmn:extensionElements>
        <aef:uid value="n_notify"/>
        <aef:position x="1420.0" y="204.9"/>
        <aef:endpoint>lib/notify.sh:fw_notify</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="frw_9_worst" name="Worst finding level?">
      <bpmn:extensionElements>
        <aef:uid value="n_verdict"/>
        <aef:position x="1220.0" y="338.4"/>
        <aef:meta decisionOwner="framework"/>
        <aef:decisionInput>${max_severity}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="frw_1_fan" name="Fan out to check sections">
      <bpmn:extensionElements>
        <aef:uid value="n_fork"/>
        <aef:position x="320.0" y="338.4"/>
        <aef:meta gatewayKind="fork"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:parallelGateway id="frw_7_join" name="Join — all sections complete">
      <bpmn:extensionElements>
        <aef:uid value="n_join"/>
        <aef:position x="820.0" y="338.4"/>
        <aef:meta gatewayKind="join"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_1_audit" targetRef="frw_1_fan">
      <bpmn:extensionElements>
        <aef:uid value="e_trigger_fork"/>
        <aef:anchors targetPort="W"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" sourceRef="frw_1_fan" targetRef="frw_2_compliance">
      <bpmn:extensionElements>
        <aef:uid value="e_fork_compliance"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" sourceRef="frw_1_fan" targetRef="frw_6_traceability">
      <bpmn:extensionElements>
        <aef:uid value="e_fork_traceability"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" sourceRef="frw_1_fan" targetRef="frw_4_enforcement">
      <bpmn:extensionElements>
        <aef:uid value="e_fork_enforcement"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" sourceRef="frw_1_fan" targetRef="frw_5_learning">
      <bpmn:extensionElements>
        <aef:uid value="e_fork_learning"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" sourceRef="frw_1_fan" targetRef="frw_3_discovery">
      <bpmn:extensionElements>
        <aef:uid value="e_fork_discovery"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" sourceRef="frw_2_compliance" targetRef="frw_7_join">
      <bpmn:extensionElements>
        <aef:uid value="e_compliance_join"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" sourceRef="frw_6_traceability" targetRef="frw_7_join">
      <bpmn:extensionElements>
        <aef:uid value="e_traceability_join"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" sourceRef="frw_4_enforcement" targetRef="frw_7_join">
      <bpmn:extensionElements>
        <aef:uid value="e_enforcement_join"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" sourceRef="frw_5_learning" targetRef="frw_7_join">
      <bpmn:extensionElements>
        <aef:uid value="e_learning_join"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_11" sourceRef="frw_3_discovery" targetRef="frw_7_join">
      <bpmn:extensionElements>
        <aef:uid value="e_discovery_join"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_12" sourceRef="frw_7_join" targetRef="frw_8_aggregate">
      <bpmn:extensionElements>
        <aef:uid value="e_join_aggregate"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_13" sourceRef="frw_8_aggregate" targetRef="frw_9_worst">
      <bpmn:extensionElements>
        <aef:uid value="e_aggregate_verdict"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_14" name="any FAIL" sourceRef="frw_9_worst" targetRef="frw_12_push">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${fail_count &gt; 0}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_verdict_fail"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_15" name="any WARN (no FAIL)" sourceRef="frw_9_worst" targetRef="frw_11_audit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${fail_count == 0 &amp;&amp; warn_count &gt; 0}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_verdict_warn"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_16" name="clean" sourceRef="frw_9_worst" targetRef="frw_10_audit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${fail_count == 0 &amp;&amp; warn_count == 0}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_verdict_pass"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_17" sourceRef="frw_12_push" targetRef="frw_13_audit">
      <bpmn:extensionElements>
        <aef:uid value="e_notify_end"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>