<?xml version="1.0" encoding="UTF-8"?>
<!-- Flow node 'frw_2_b' is not listed in any lane's flowNodeRef set -> E-XML-NODE-UNASSIGNED
     (ERROR). Was W-XML-NODE-UNASSIGNED (WARN) until T-891 promoted it: a node in no lane has no
     authority-of-record (mapping-v1 section 3), so an owner cannot be derived. Refiled from warn/ to
     invalid/ under T-990, because the suite reads the expected rule and exit code from the path. -->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:aef="http://anchorpoint.framework/aef/extensions">
  <bpmn:process id="Pool_t" name="t">
    <bpmn:laneSet id="LaneSet_t">
      <bpmn:lane id="framework" name="Framework">
        <bpmn:flowNodeRef>frw_1_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_2_typo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="frw_1_a">
      <bpmn:extensionElements><aef:uid value="n_a"/></bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="frw_2_b">
      <bpmn:extensionElements><aef:uid value="n_b"/></bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="frw_1_a" targetRef="frw_2_b">
      <bpmn:extensionElements><aef:uid value="e_1"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
