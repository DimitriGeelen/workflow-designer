import re, xml.etree.ElementTree as ET
src = open('SOURCE.md').read()
src_flat = ' '.join(src.split())  # unwrap line breaks
ns = {'bpmn':'http://www.omg.org/spec/BPMN/20100524/MODEL'}
tree = ET.parse('map.bpmn')
bad = 0
for el in tree.iter():
    doc = el.find('bpmn:documentation', ns)
    if doc is None or not (doc.text or '').strip():
        continue
    for line in doc.text.split('\n'):
        line = line.strip()
        m = re.match(r'source:\s*"(.*)"\s*$', line)
        if not m:
            if line.startswith('source:'):
                print(f"UNSTATED-DECL {el.get('id')}: {line[:90]}")
            continue
        q = ' '.join(m.group(1).split())
        ok = q in src_flat
        if not ok:
            bad += 1
            print(f"NOT-VERBATIM {el.get('id')}: {q[:100]}")
print("bad quotes:", bad)
EOF
