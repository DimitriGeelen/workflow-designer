Step 2/8: Calibrate with codex (OpenAI): build the 0.27.0 kit, loop.sh --calibrate, record the result
  runs: do_calibrate codex openai "$CODEX_CMD"
        | do_calibrate () 
        | { 
        |     local name="$1" vendor="$2" cmd="$3" kit wd res rc;
        |     kit=$(mktemp -d /tmp/t1306-kit-$name.XXXXXX) || return 1;
        |     python3 tools/build-authoring-kit.py --version "$V" --out "$kit/kit" > /dev/null || { 
        |         echo "kit build failed";
        |         rm -rf "$kit";
        |         return 1
        |     };
        |     wd="$OUT/calibrate-$name";
        |     res="$OUT/calibrate-$name.out";
        |     mkdir -p "$wd";
        |     echo "kit: $kit/kit (sha256 of SHA256SUMS $(sha256sum "$kit/kit/SHA256SUMS" | cut -c1-16)...), reviewer: $cmd";
        |     ( export PATH="$NODEBIN:$OCBIN:$PATH" KIT_REVIEWER_CMD="$cmd";
        |     bash "$kit/kit/loop.sh" --calibrate "$PWD/$wd" ) 2>&1 | tee "$res";
        |     python3 tools/kit-calibration-gate.py record --version "$V" --reviewer "$name" --vendor "$vendor" --result-file "$res";
        |     rc=$?;
        |     rm -rf "$kit";
        |     grep -E 'CALIBRATION: (PASS|FAIL|COULD NOT MEASURE)' "$res" | tail -1;
        |     [ "$rc" = 0 ] || { 
        |         echo "$name did not PASS (recorded); nothing is released — the agent brings it to you";
        |         return 1
        |     }
        | }
