import re, xml.etree.ElementTree as ET
NS={'b':'http://www.omg.org/spec/BPMN/20100524/MODEL'}
src=open('SOURCE.md').read()
root=ET.parse('map.bpmn').getroot()
bad=0; checked=0
for el in root.iter():
    doc=el.find('b:documentation',NS)
    if doc is None or not (doc.text or '').strip(): continue
    for line in doc.text.splitlines():
        line=line.strip()
        m=re.match(r'^source: "(.*)"$', line, re.S)
        if not m: continue
        checked+=1
