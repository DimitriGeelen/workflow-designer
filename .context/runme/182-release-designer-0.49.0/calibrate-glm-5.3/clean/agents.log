import re, xml.etree.ElementTree as ET
src = open('SOURCE.md').read()
# whitespace-normalized source text
norm = lambda s: re.sub(r'\s+', ' ', s).strip()
srcn = norm(src)
tree = ET.parse('map.bpmn')
ns = {'bpmn': 'http://www.omg.org/spec/BPMN/20100524/MODEL'}
bad = []
count = 0
for el in tree.iter():
    doc = el.find('bpmn:documentation', ns)
    if doc is None or not (doc.text or '').strip():
        continue
    for line in (doc.text or '').splitlines():
        line = line.strip()
        if not line.startswith('source:'):
            continue
        count += 1
        m = re.match(r'source:\s*"(.*)"\s*$', line)
        if m:
            q = norm(m.group(1))
            if q not in srcn:
                bad.append((el.get('id'), 'NOT VERBATIM', m.group(1)))
        elif 'unstated' in line:
            pass
        else:
            bad.append((el.get('id'), 'UNPARSEABLE', line))
print(f"checked {count} source: lines")
for b in bad: print(b)
print("OK" if not bad else "PROBLEMS FOUND")
# also check gateway branch labels against source words
for f in tree.iter('{http://www.omg.org/spec/BPMN/20100524/MODEL}sequenceFlow'):
    n = f.get('name')
    if n:
        print("branch label:", repr(n), "-> in source:", norm(n) in srcn)
