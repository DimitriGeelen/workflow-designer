        |     git reset -q HEAD -- "$DIV" .agentic-framework/.context/settings.yaml .agentic-framework/.context/sidecar 2> /dev/null;
        |     if git diff --cached --name-only | grep -v '^\.agentic-framework/' | grep -q .; then
