  runs: do_upgrade
        | do_upgrade () 
        | { 
        |     local src here="$PWD";
        |     src=$(mktemp -d /var/tmp/t1319-be40.XXXXXX) || return 1;
        |     git clone -q "$UPSTREAM" "$src/fw" || { 
        |         rm -rf "$src";
        |         return 1
        |     };
        |     git -C "$src/fw" -c advice.detachedHead=false checkout -q "$SHA" || { 
        |         echo "commit $SHA not found upstream";
        |         rm -rf "$src";
        |         return 1
        |     };
        |     [ "$(git -C "$src/fw" rev-parse HEAD)" = "$SHA" ] || { 
        |         echo "checked out $(git -C "$src/fw" rev-parse HEAD), expected $SHA";
        |         rm -rf "$src";
        |         return 1
        |     };
        |     git -C "$src/fw" merge-base --is-ancestor "$FROM" "$SHA" || { 
        |         echo "$FROM is not an ancestor of $SHA";
        |         rm -rf "$src";
        |         return 1
        |     };
        |     ( cd "$src/fw" && env -u PROJECT_ROOT -u CONTEXT_DIR -u TASKS_DIR FRAMEWORK_ROOT="$src/fw" bin/fw upgrade "$here" --allow-delete-locals );
        |     local rc=$?;
        |     rm -rf "$src";
        |     [ "$rc" = 0 ] || { 
        |         echo "fw upgrade exited $rc";
        |         return 1
        |     };
        |     [ "$(sed -n 's/^version_sha: *//p' .framework.yaml)" = "$SHA" ] || { 
        |         echo ".framework.yaml version_sha is not $SHA after the upgrade";
        |         return 1
        |     };
        |     echo "VERSION now: $(tr -d '[:space:]' < .agentic-framework/VERSION)";
        |     bash tools/_t1000-install-hook.sh > /dev/null && bash tools/_t1000-install-hook.sh --check
        | }
