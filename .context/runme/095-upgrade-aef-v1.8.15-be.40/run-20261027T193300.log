Step 6/9: Advance the divergence baseline to that commit (commit it alone)
  runs: do_baseline
        | do_baseline () 
        | { 
        |     local p;
        |     p=$(git rev-parse HEAD);
        |     git show --name-only --format= HEAD | grep -q '^\.agentic-framework/' || { 
        |         echo "HEAD is not the pristine commit";
        |         return 1
        |     };
        |     python3 - "$DIV" "$p" <<'PY' || 
        | import re, sys, yaml
        | path, sha = sys.argv[1:]
        | lines = open(path).read().split("\n")
        | out, skip = [], False
        | for ln in lines:
        |     if ln.startswith("baseline_note_previous:"):
        |         skip = True; continue
        |     if skip and (ln.startswith(" ") or ln == ""):
        |         continue
        |     skip = False
        |     out.append(ln)
        | s = "\n".join(out)
        | s, n = re.subn(r'^baseline_commit:.*$', 'baseline_commit: %s' % sha, s, count=1, flags=re.M)
        | if n != 1: sys.exit(1)
        | s, n = re.subn(r'^baseline_note:', 'baseline_note_previous:', s, count=1, flags=re.M)
        | if n != 1: sys.exit(1)
        | s = s.replace('baseline_commit: %s' % sha, 'baseline_commit: %s\nbaseline_note: "T-1319/T-1000 — pristine vendor commit of AEF v1.8.15-be.40 (be0b8738a; re-vendor protocol step 1). Every declared local fix the upgrade overwrote now shows STALE in tools/_t517; resolve each via tools/_t1000-revendor-worklist.py."' % sha, 1)
        | yaml.safe_load(s)
        | open(path, "w").write(s)
        | PY
        |  return 1
        |     git add -- "$DIV" .framework.yaml && git commit -q -m "T-1319: advance the divergence baseline to the pristine AEF v1.8.15-be.40 commit, and record the upgrade in .framework.yaml (re-vendor protocol step 2, T-1000)" -- "$DIV" .framework.yaml
        | }
