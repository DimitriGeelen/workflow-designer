        | do_verify () 
        | { 
        |     local rel;
        |     rel=$(git rev-parse "$TAG^{commit}") || { 
        |         echo "cannot resolve $TAG";
        |         return 1
        |     };
        |     [ "$(git log -1 --format=%H -- "$ART")" = "$rel" ] || { 
        |         echo "$TAG is not on the commit that carries $ART";
        |         return 1
        |     };
        |     git show "$TAG:src/aef-workflow-designer.html" | cmp -s - "$ART" || { 
        |         echo "$ART differs from src at $TAG";
        |         return 1
        |     };
        |     cmp -s src/aef-workflow-designer.html "$ART" || { 
        |         echo "src has changed since the release (it should not have)";
        |         return 1
        |     };
        |     ( cd "$KIT" && sha256sum -c SHA256SUMS --quiet ) || { 
        |         echo "the kit does not verify against its SHA256SUMS";
        |         return 1
        |     };
        |     python3 tools/kit-calibration-gate.py check --version "$V" || { 
        |         echo "calibration gate refuses $V";
        |         return 1
        |     };
        |     echo "ok  $TAG on $(git rev-parse --short "$rel"); artifact == src (sha256 $(sha256sum "$ART" | cut -c1-16)..., $(stat -c %s "$ART") bytes); kit verifies; gate passes"
        | }
