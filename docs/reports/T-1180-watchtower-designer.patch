+<script>
+(function () {
+  // 832 T-1171: open = click the card's own editor link (it mints the T-2596 nonce and stays the only ?load link).
+  window.corpusOpenCard = function (el) {
+    var card = el.closest('.corpus-card');
+    var a = card && card.querySelector('a.corpus-open:not(.corpus-overlay)');
+    if (a) a.click();
+  };
+  var SHOW_MS = 160, HIDE_MS = 120;
+  function place(wrap) {
+    var fly = wrap.querySelector('.corpus-flyout');
+    if (!fly) return;
+    var r = wrap.getBoundingClientRect(), w = fly.offsetWidth, h = fly.offsetHeight, m = 8;
+    var cx = r.left + r.width / 2, left = cx - w / 2;
+    var fx = Math.min(Math.max(left, m), window.innerWidth - w - m) - left;
+    var top = r.top - 24, fy = 0;
+    if (top < m) fy = m - top;
+    else if (top + h > window.innerHeight - m) fy = Math.max(m - top, window.innerHeight - m - h - top);
+    fly.style.setProperty('--fx', fx + 'px');
+    fly.style.setProperty('--fy', fy + 'px');
+  }
+  // Wire each wrap once, however often htmx re-inserts this page.
+  document.querySelectorAll('.corpus-thumb-wrap').forEach(function (wrap) {
+    if (wrap.__flyWired) return;
+    wrap.__flyWired = true;
+    var tShow = null, tHide = null;
+    wrap.addEventListener('mouseenter', function () {
+      clearTimeout(tHide);
+      tShow = setTimeout(function () { place(wrap); wrap.classList.add('fly'); }, SHOW_MS);
+    });
+    wrap.addEventListener('mouseleave', function () {
+      clearTimeout(tShow);
+      tHide = setTimeout(function () { wrap.classList.remove('fly'); }, HIDE_MS);
+    });
+  });
+})();
+</script>
diff --git a/web/templates/designer_open.html b/web/templates/designer_open.html
new file mode 100644
index 00000000..cc332b24
--- /dev/null
+++ b/web/templates/designer_open.html
@@ -0,0 +1,76 @@
+{# 832 T-1172: a map opened INLINE in Watchtower — the normal navigation stays on the page, the designer runs in a
+   frame below it, and a fullscreen toggle gives it the whole screen and back (operator, 2026-10-14: "same as the
+   component fabric browser"; fabric_explorer.html toggleFullscreen). Before this, "Open in editor" went to
+   /designer/app, the bare bundle as the whole tab, and only the browser's Back returned to Watchtower.
+   The frame loads /designer/app with the same load value, so its deep-link and the T-2596/T-2599 nonce flow are
+   untouched (the app route 302-mints a nonce when the value carries none). #}
+<style>
+    /* 832 T-1175 (operator 2026-10-14: "use the full width when available"): lift Watchtower's container cap on
+       this page only — single-level :has(), as base.html already uses. */
+    main#content:has(#dsg-stage) { max-width: none; padding-left: 12px; padding-right: 12px; }
+    .dsg-open-bar { display: flex; align-items: center; gap: 0.75rem; margin: 0 0 0.5rem 0; }
+    .dsg-open-bar h2 { margin: 0; font-size: 1.1rem; }
+    .dsg-open-bar .dsg-spacer { flex: 1; }
+    .dsg-open-bar code { font-size: 0.8rem; color: var(--pico-muted-color); }
+    #dsg-fullscreen-btn { padding: 0.2rem 0.6rem; font-size: 1.1rem; line-height: 1.2; margin: 0; width: auto; }
+    #dsg-stage { position: relative; border: 1px solid var(--pico-muted-border-color, #d0d0d0); border-radius: 6px;
+                 overflow: hidden; background: #fff; }
+    #dsg-stage iframe { display: block; width: 100%; height: 100%; border: 0; }
+    #dsg-stage:fullscreen { border: 0; border-radius: 0; width: 100vw; height: 100vh; }
+    #dsg-stage:fullscreen #dsg-fs-exit { display: block; }
+    /* Bottom-right: the designer's own toolbar runs along the top edge, so a corner button there covered its
+       Versions / Save project buttons (seen in the fullscreen screenshot). */
+    #dsg-fs-exit { display: none; position: absolute; bottom: 14px; right: 14px; z-index: 2; padding: 0.2rem 0.6rem;
+                   margin: 0; width: auto; font-size: 1rem; opacity: 0.85; }
+</style>
+
+<div class="dsg-open-bar">
+    <a href="/designer" title="Back to all maps">&larr; Maps</a>
+    <h2>{{ map_title }}</h2>
+    {% if map_version %}<code>v{{ map_version }}</code>{% endif %}
+    <span class="dsg-spacer"></span>
+    <a href="{{ editor_url }}" hx-boost="false" title="Open the designer on its own, as the whole tab">Open alone</a>
+    <button type="button" id="dsg-fullscreen-btn" class="secondary outline" onclick="dsgToggleFullscreen()"
+            title="Fullscreen (Esc to come back)" aria-label="Fullscreen">&#x26F6;</button>
+</div>
+
+<div id="dsg-stage">
+    <button type="button" id="dsg-fs-exit" class="secondary" onclick="dsgToggleFullscreen()"
+            title="Exit fullscreen (Esc)" aria-label="Exit fullscreen">&#x2716;</button>
+    <iframe id="dsg-frame" src="{{ editor_url }}" title="Workflow Designer — {{ map_title }}"
+            allow="fullscreen; clipboard-read; clipboard-write"></iframe>
+</div>
+
+<script>
+(function () {
+  // Fill the rest of the viewport below the navigation, and keep doing so on resize.
+  function fit() {
+    var st = document.getElementById('dsg-stage');
+    if (!st || document.fullscreenElement === st) return;
+    var top = st.getBoundingClientRect().top;
+    st.style.height = Math.max(320, window.innerHeight - top - 12) + 'px';
+  }
+  window.dsgToggleFullscreen = function () {
+    var st = document.getElementById('dsg-stage');
+    if (!st) return;
+    if (document.fullscreenElement !== st) { st.requestFullscreen().catch(function () {}); }
+    else { document.exitFullscreen().catch(function () {}); }
+  };
+  function sync() {
+    var btn = document.getElementById('dsg-fullscreen-btn');
+    var st = document.getElementById('dsg-stage');
+    if (!btn || !st) return;
+    var on = document.fullscreenElement === st;
+    btn.innerHTML = on ? '&#x2716;' : '&#x26F6;';
+    btn.title = on ? 'Exit fullscreen (Esc)' : 'Fullscreen (Esc to come back)';
+    if (!on) fit();
+  }
+  // Listeners once per document, however often htmx re-inserts this fragment.
+  if (!window.__dsgOpenWired) {
+    window.__dsgOpenWired = true;
+    document.addEventListener('fullscreenchange', sync);
+    window.addEventListener('resize', fit);
+  }
+  fit();
+})();
+</script>
