    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="close (demo evidence)" sourceRef="hum_gw_close" targetRef="frw_1_close">
      <bpmn:extensionElements>
        <aef:uid value="e_71342d97"/>
        <x832:origin xmlns:x832="urn:832-workflow-designer:origin:1" originalId="Flow_3"/>
