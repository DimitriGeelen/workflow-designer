<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_arc-lifecycle_v2"
                  exporter="aef-workflow-designer"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_arc-lifecycle_v2">
    <bpmn:participant id="Pool_arc-lifecycle" name="arc-lifecycle" processRef="Process_arc-lifecycle_v2"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_arc-lifecycle_v2" isExecutable="false">
    <bpmn:extensionElements>
      <aef:workflowMeta id="arc-lifecycle_v2" uuid="acfa6e19-8649-4783-9b36-4198a17a55b8" version="1" schemaVersion="2" title="arc-lifecycle" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="108"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>hum_1_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hum_2_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hum_gw_close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="96"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_end_arc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_end_arc_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_1_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_2_abandon</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="96"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_start_arc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_3_tag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_4_bvp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_5_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_1_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_6_emit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:userTask id="hum_1_approve" name="Approve value drivers (human-only)">
      <bpmn:extensionElements>
        <aef:uid value="n_approve_driver"/>
        <aef:position x="920.0" y="84.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="hum_2_close" name="Close or abandon? (human-only)">
      <bpmn:extensionElements>
        <aef:uid value="n_close_decide"/>
        <aef:position x="1400.0" y="84.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="hum_gw_close" name="Close or abandon?">
      <bpmn:extensionElements>
        <aef:uid value="n_route"/>
        <aef:position x="1560.0" y="92.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="frw_end_arc" name="Arc closed (immutable)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_closed"/>
        <aef:position x="2040.0" y="200.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_end_arc_2" name="Arc abandoned (immutable)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_abandoned"/>
        <aef:position x="2200.0" y="200.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:scriptTask id="frw_1_close" name="Close arc (in-progress → closed) + record demo_evidence">
      <bpmn:extensionElements>
        <aef:uid value="n_close"/>
        <aef:position x="1720.0" y="186.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_2_abandon" name="Abandon arc (reason ≥30 chars)">
      <bpmn:extensionElements>
        <aef:uid value="n_abandon"/>
        <aef:position x="1880.0" y="186.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:startEvent id="agt_start_arc" name="Arc proposed (headline mechanic identified)">
      <bpmn:extensionElements>
        <aef:uid value="n_req"/>
        <aef:position x="120.0" y="296.0"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="agt_3_tag" name="Tag member tasks (arc_id / arc: tag)">
      <bpmn:extensionElements>
        <aef:uid value="n_tag"/>
        <aef:position x="600.0" y="282.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_4_bvp" name="BVP rescore (writes PROPOSED scores only)">
      <bpmn:extensionElements>
        <aef:uid value="n_bvp"/>
        <aef:position x="760.0" y="282.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_5_work" name="Work member tasks (each = own task-lifecycle + Evolution log)">
      <bpmn:extensionElements>
        <aef:uid value="n_work"/>
        <aef:position x="1080.0" y="282.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:scriptTask id="agt_1_create" name="Create arc (status draft, immutable arc-NNN)">
      <bpmn:extensionElements>
        <aef:uid value="n_create"/>
        <aef:position x="280.0" y="282.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="agt_2_start" name="Start arc (draft → in-progress)">
      <bpmn:extensionElements>
        <aef:uid value="n_start"/>
        <aef:position x="440.0" y="282.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="agt_6_emit" name="Emit close review surface (Watchtower URL + QR)">
      <bpmn:extensionElements>
        <aef:uid value="n_review"/>
        <aef:position x="1240.0" y="282.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:sequenceFlow id="flow_1" sourceRef="hum_1_approve" targetRef="agt_5_work">
      <bpmn:extensionElements>
        <aef:uid value="e_733430bd"/>
        <x832:origin xmlns:x832="urn:832-workflow-designer:origin:1" originalId="Flow_1"/>
