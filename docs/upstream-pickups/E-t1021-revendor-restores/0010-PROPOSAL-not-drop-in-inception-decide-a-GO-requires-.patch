 lib/inception.sh                         |  32 ++++
 lib/task-audit.sh                        | 127 ++++++++++++++
 tests/unit/test_t1021_hypothesis_gate.sh | 205 +++++++++++++++++++++++
 3 files changed, 364 insertions(+)
