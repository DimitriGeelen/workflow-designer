<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Defs_nolaneset" targetNamespace="http://example.org/t358">
  <bpmn:process id="Proc_nolaneset" name="No lane set" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Begin"/>
    <bpmn:task id="Task_1" name="Do the thing"/>
    <bpmn:endEvent id="End_1" name="Done"/>
    <bpmn:sequenceFlow id="F_1" sourceRef="Start_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="F_2" sourceRef="Task_1" targetRef="End_1"/>
  </bpmn:process>
</bpmn:definitions>
