<?xml version="1.0" encoding="UTF-8"?>
<!-- T-1327 fixture: a file as another tool writes it, with a parent lane holding two nested lanes (F9), a comment
     between two elements (F11), and DI with the tool's own sizes. Hand-written for the T-1327 harness and screenshots;
     the nesting is what the designer cannot keep yet, so the import notice must say so. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_t1327" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.16.0">
  <bpmn:collaboration id="Collaboration_t1327">
    <bpmn:participant id="Participant_orders" name="Order handling" processRef="Process_orders"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_orders" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_sales" name="Sales">
        <bpmn:childLaneSet id="LaneSet_sales">
          <bpmn:lane id="Lane_inside" name="Inside sales">
            <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_quote</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Lane_field" name="Field sales">
            <bpmn:flowNodeRef>Task_visit</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
      <bpmn:lane id="Lane_ops" name="Operations">
        <bpmn:flowNodeRef>Task_ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Order received"/>
    <!-- quote first, then the visit: the field team needs the price -->
    <bpmn:task id="Task_quote" name="Prepare quote"/>
    <bpmn:task id="Task_visit" name="Visit customer"/>
    <bpmn:task id="Task_ship" name="Ship order"/>
    <bpmn:endEvent id="End_1" name="Order shipped"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_quote"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_quote" targetRef="Task_visit"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_visit" targetRef="Task_ship"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ship" targetRef="End_1"/>
    <!-- reviewed with the ops lead, 2026-10 -->
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_t1327">
      <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant_orders" isHorizontal="true"><dc:Bounds x="120" y="60" width="760" height="380"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="200" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_quote_di" bpmnElement="Task_quote"><dc:Bounds x="290" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_visit_di" bpmnElement="Task_visit"><dc:Bounds x="440" y="200" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ship_di" bpmnElement="Task_ship"><dc:Bounds x="590" y="330" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"><dc:Bounds x="752" y="352" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="236" y="120"/><di:waypoint x="290" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="390" y="120"/><di:waypoint x="415" y="120"/><di:waypoint x="415" y="240"/><di:waypoint x="440" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="540" y="240"/><di:waypoint x="565" y="240"/><di:waypoint x="565" y="370"/><di:waypoint x="590" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="690" y="370"/><di:waypoint x="752" y="370"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
