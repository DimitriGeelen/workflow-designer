<?xml version="1.0" encoding="UTF-8"?>
<!-- T-1096: a quote process that reads and writes data — a data object (Quote) passed between two tasks and a
     data store (CRM) written to. The shape every mainstream modeller emits for data. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:aef="http://anchorpoint.framework/aef/extensions" id="Defs_t1096" targetNamespace="https://example.invalid/t1096">
  <bpmn:process id="Process_t1096" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_sales" name="Sales">
        <!-- laneMeta + aef:uid: the corpus harnesses over tests/fixtures/aef-bpmn/ mutate lane metadata and count uids -->
        <bpmn:extensionElements><aef:laneMeta abbr="sal" authority="initiative" height="200"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>t_draft</bpmn:flowNodeRef><bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="DataObject_quote"/>
    <bpmn:dataObjectReference id="DOR_quote" name="Quote" dataObjectRef="DataObject_quote"/>
    <bpmn:dataStoreReference id="DSR_crm" name="CRM"/>
    <bpmn:task id="t_draft" name="Draft quote">
      <bpmn:extensionElements><aef:uid value="n_t1096_draft"/></bpmn:extensionElements>
      <bpmn:dataOutputAssociation id="DOA_draft"><bpmn:targetRef>DOR_quote</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t_send" name="Send quote">
      <bpmn:extensionElements><aef:uid value="n_t1096_send"/></bpmn:extensionElements>
      <bpmn:property id="Prop_send" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_send"><bpmn:sourceRef>DOR_quote</bpmn:sourceRef><bpmn:targetRef>Prop_send</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_crm"><bpmn:targetRef>DSR_crm</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="f_1" sourceRef="t_draft" targetRef="t_send">
      <bpmn:extensionElements><aef:uid value="e_t1096_1"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_t1096"><bpmndi:BPMNPlane id="Plane_t1096" bpmnElement="Process_t1096">
    <bpmndi:BPMNShape id="t_draft_di" bpmnElement="t_draft"><dc:Bounds x="160" y="100" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t_send_di" bpmnElement="t_send"><dc:Bounds x="360" y="100" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DOR_quote_di" bpmnElement="DOR_quote"><dc:Bounds x="292" y="225" width="36" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DSR_crm_di" bpmnElement="DSR_crm"><dc:Bounds x="485" y="225" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="f_1_di" bpmnElement="f_1"><di:waypoint x="260" y="140"/><di:waypoint x="360" y="140"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DOA_draft_di" bpmnElement="DOA_draft"><di:waypoint x="230" y="180"/><di:waypoint x="292" y="245"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DIA_send_di" bpmnElement="DIA_send"><di:waypoint x="328" y="245"/><di:waypoint x="380" y="180"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DOA_crm_di" bpmnElement="DOA_crm"><di:waypoint x="440" y="180"/><di:waypoint x="495" y="225"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
