<?xml version="1.0" encoding="UTF-8"?>
<!-- T-972: lane 'ops' carries no laneMeta at all -> W-XML-LANE-NO-AUTHORITY
     (WARN), and nothing else.

     The point of the rule: a lane that DECLARES authority="none" draws
     W-LANE-NO-OWNER on each of its tasks, while a lane that says nothing used to
     draw nothing. Omission was quieter than an honest unknown. The plain <task>
     in the lane matters too: T-970 made it valid, and it must be counted as a
     task whose owner cannot be derived (the message says "1 task(s)"). -->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:aef="http://anchorpoint.framework/aef/extensions">
  <bpmn:process id="Pool_t" name="t">
    <bpmn:extensionElements>
      <aef:workflowMeta id="t"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LS">
      <bpmn:lane id="ops" name="Operations">
        <bpmn:flowNodeRef>n_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_s"/>
    <bpmn:task id="n_a" name="Pick order"/>
    <bpmn:endEvent id="n_e"/>
    <bpmn:sequenceFlow id="f0" sourceRef="n_s" targetRef="n_a"/>
    <bpmn:sequenceFlow id="f1" sourceRef="n_a" targetRef="n_e"/>
  </bpmn:process>
</bpmn:definitions>
