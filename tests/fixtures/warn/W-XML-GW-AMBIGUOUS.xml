<?xml version="1.0" encoding="UTF-8"?>
<!-- exclusiveGateway n_g has THREE outgoing flows and none of them carries a
     bpmn:conditionExpression, so a runtime has no defined choice between them
     -> W-XML-GW-AMBIGUOUS (WARN). Parity with the YAML path's W-GW-AMBIGUOUS.

     Deliberately three rather than two, so the count in the message is not
     confusable with the >= 2 boundary of E-XML-GW-OUTGOING: this fixture must
     fail for ambiguity, not for arity. The silent-at-exactly-one boundary is
     covered by tests/fixtures/valid/gw-single-default.xml.

     Every node is lane-assigned so W-XML-NODE-UNASSIGNED stays quiet, and every
     branch reaches the end event so W-XML-DEADEND / W-XML-UNREACHABLE do too —
     a fixture that fires three rules cannot prove which one the suite caught. -->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:aef="http://anchorpoint.framework/aef/extensions">
  <bpmn:process id="Pool_t" name="t">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="agent" name="Agent">
        <bpmn:flowNodeRef>n_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_s"/>
    <bpmn:exclusiveGateway id="n_g" name="which failure type?"/>
    <bpmn:scriptTask id="n_a"/>
    <bpmn:scriptTask id="n_b"/>
    <bpmn:scriptTask id="n_c"/>
    <bpmn:endEvent id="n_e"/>
    <bpmn:sequenceFlow id="f0" sourceRef="n_s" targetRef="n_g"/>
    <bpmn:sequenceFlow id="f1" name="code" sourceRef="n_g" targetRef="n_a"/>
    <bpmn:sequenceFlow id="f2" name="design" sourceRef="n_g" targetRef="n_b"/>
    <bpmn:sequenceFlow id="f3" name="environment" sourceRef="n_g" targetRef="n_c"/>
    <bpmn:sequenceFlow id="f4" sourceRef="n_a" targetRef="n_e"/>
    <bpmn:sequenceFlow id="f5" sourceRef="n_b" targetRef="n_e"/>
    <bpmn:sequenceFlow id="f6" sourceRef="n_c" targetRef="n_e"/>
  </bpmn:process>
</bpmn:definitions>
