<?xml version="1.0" encoding="UTF-8"?>
<!-- parallel fork n_f (out-degree 2) has no matching parallel join anywhere ->
     forked branches never reconverge -> W-XML-PGW-UNBALANCED (WARN). Fork edges
     carry no condition; fork out-degree 2 so W-XML-PGW-NOOP does not fire. -->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:aef="http://anchorpoint.framework/aef/extensions">
  <bpmn:process id="Pool_t" name="t">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="agent" name="Agent">
        <bpmn:flowNodeRef>n_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_b</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_s"/>
    <bpmn:parallelGateway id="n_f"/>
    <bpmn:endEvent id="n_a"/>
    <bpmn:endEvent id="n_b"/>
    <bpmn:sequenceFlow id="f0" sourceRef="n_s" targetRef="n_f"/>
    <bpmn:sequenceFlow id="f1" sourceRef="n_f" targetRef="n_a"/>
    <bpmn:sequenceFlow id="f2" sourceRef="n_f" targetRef="n_b"/>
  </bpmn:process>
</bpmn:definitions>
