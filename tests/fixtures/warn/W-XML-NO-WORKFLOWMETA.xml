<?xml version="1.0" encoding="UTF-8"?>
<!-- T-972: a complete, connected, lane-governed map that carries NO workflow
     metadata element -> W-XML-NO-WORKFLOWMETA (WARN), and nothing else.

     The map has no id of its own and no kind, so it is judged as an executable
     process. This is the state all 26 Evergreen maps were in across 130 saves,
     and no rule said so. Everything else here is deliberately correct (lane
     authority stated, one start, one end, every node reachable) so the finding
     can only be this rule's. -->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:aef="http://anchorpoint.framework/aef/extensions">
  <bpmn:process id="Pool_t" name="t">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="agent" name="Agent">
        <bpmn:extensionElements><aef:laneMeta authority="initiative"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>n_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_s"/>
    <bpmn:scriptTask id="n_a"/>
    <bpmn:endEvent id="n_e"/>
    <bpmn:sequenceFlow id="f0" sourceRef="n_s" targetRef="n_a"/>
    <bpmn:sequenceFlow id="f1" sourceRef="n_a" targetRef="n_e"/>
  </bpmn:process>
</bpmn:definitions>
