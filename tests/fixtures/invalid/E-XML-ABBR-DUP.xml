<?xml version="1.0" encoding="UTF-8"?>
<!-- T-820 witness fixture for E-XML-ABBR-DUP.

     Derived from E-XML-AUTHORITY.xml (itself bridge-generated) by collapsing the SECOND
     lane's abbr onto the first: both lanes now declare abbr="frw". That is the violation
     and the only one - the out-of-enum authority="overlord" the source fixture carries was
     restored to a valid value, so this document witnesses ONE rule rather than two.

     Why a fixture and not a declaration: tools/_t816-abbr-dup-controls.sh already proves the
     rule fires, but it does so in a throwaway temp copy that no other instrument can see.
     test_check_pass_reachability.py wants a DURABLE witness, and it is right to -
     "a rule nobody has ever seen fire is a rule nobody has shown to work". -->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:aef="http://anchorpoint.framework/aef/extensions"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="Pool_t" name="t">

    <bpmn:laneSet id="LaneSet_t">
      <bpmn:lane id="framework" name="Framework">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="130"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>n_a</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="initiative" height="320"/>
        </bpmn:extensionElements>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="n_a" name="Start">
      <bpmn:extensionElements>
        <aef:uid value="n_a"/>
        <aef:position x="100" y="100"/>
      </bpmn:extensionElements>
    </bpmn:startEvent>


  </bpmn:process>
</bpmn:definitions>
