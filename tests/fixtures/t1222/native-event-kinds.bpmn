<?xml version="1.0" encoding="UTF-8"?>
<!-- T-1222 fixture: third-party native event definitions as bpmn.io writes them, one of each case the fix decides:
     a timer catch and a message boundary (typed from their definition), a signal catch and an escalation boundary
     (plain catch: no designer type), a signal throw (plain throw), and a boundary event with no definition. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_t1222" targetNamespace="http://example.com/t1222">
  <bpmn:message id="Message_order" name="Order received"/>
  <bpmn:signal id="Signal_stock" name="Stock low"/>
  <bpmn:escalation id="Escalation_manager" name="Manager" escalationCode="MGR"/>
  <bpmn:process id="Process_t1222" name="Native event kinds" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Start"/>
    <bpmn:task id="Task_check" name="Check order"/>
    <bpmn:intermediateCatchEvent id="Catch_timer" name="Wait one day">
      <bpmn:timerEventDefinition id="TimerDef_1"><bpmn:timeDuration>P1D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_signal" name="Stock low">
      <bpmn:signalEventDefinition id="SignalDef_1" signalRef="Signal_stock"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_ship" name="Ship order"/>
    <bpmn:intermediateThrowEvent id="Throw_signal" name="Announce shipped">
      <bpmn:signalEventDefinition id="SignalDef_2" signalRef="Signal_stock"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_1" name="Done"/>
    <bpmn:boundaryEvent id="Boundary_message" name="Order changed" attachedToRef="Task_check">
      <bpmn:messageEventDefinition id="MessageDef_1" messageRef="Message_order"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_escalation" name="Escalate" cancelActivity="false" attachedToRef="Task_ship">
      <bpmn:escalationEventDefinition id="EscalationDef_1" escalationRef="Escalation_manager"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_bare" name="Interrupted" attachedToRef="Task_ship"/>
    <bpmn:sequenceFlow id="f1" sourceRef="Start_1" targetRef="Task_check"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_check" targetRef="Catch_timer"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Catch_timer" targetRef="Catch_signal"/>
    <bpmn:sequenceFlow id="f4" sourceRef="Catch_signal" targetRef="Task_ship"/>
    <bpmn:sequenceFlow id="f5" sourceRef="Task_ship" targetRef="Throw_signal"/>
    <bpmn:sequenceFlow id="f6" sourceRef="Throw_signal" targetRef="End_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_t1222">
    <bpmndi:BPMNPlane id="Plane_t1222" bpmnElement="Process_t1222">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="152" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_check_di" bpmnElement="Task_check"><dc:Bounds x="240" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_timer_di" bpmnElement="Catch_timer"><dc:Bounds x="402" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_signal_di" bpmnElement="Catch_signal"><dc:Bounds x="502" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ship_di" bpmnElement="Task_ship"><dc:Bounds x="600" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Throw_signal_di" bpmnElement="Throw_signal"><dc:Bounds x="772" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"><dc:Bounds x="872" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_message_di" bpmnElement="Boundary_message"><dc:Bounds x="272" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_escalation_di" bpmnElement="Boundary_escalation"><dc:Bounds x="612" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_bare_di" bpmnElement="Boundary_bare"><dc:Bounds x="662" y="142" width="36" height="36"/></bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
