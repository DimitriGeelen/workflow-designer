<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1369" targetNamespace="http://example.com/t1369" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Proc_1369" isExecutable="true">
    <bpmn:laneSet id="LS"><bpmn:lane id="L1" name="Sales"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start"/>
    <bpmn:task id="T1" name="Send the quote">
      <bpmn:dataOutputAssociation id="DOA_1"><bpmn:targetRef>R_SENT</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T2" name="Customer signs">
      <bpmn:dataInputAssociation id="DIA_2"><bpmn:sourceRef>R_SENT</bpmn:sourceRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_2"><bpmn:targetRef>R_SIGNED</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T3" name="Register the order">
      <bpmn:dataInputAssociation id="DIA_3"><bpmn:sourceRef>R_SIGNED</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="E" name="Done"/>
    <bpmn:dataObject id="DO_Q"/>
    <bpmn:dataObjectReference id="R_SENT" name="Quote" dataObjectRef="DO_Q"><bpmn:dataState name="sent"/></bpmn:dataObjectReference>
    <bpmn:dataObjectReference id="R_SIGNED" name="Quote" dataObjectRef="DO_Q"><bpmn:dataState name="signed"/></bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3"/>
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="E"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1"><bpmndi:BPMNPlane id="PL1" bpmnElement="Proc_1369">
    <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="120" y="97" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="220" y="75" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="420" y="75" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="620" y="75" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="790" y="97" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="R_SENT_di" bpmnElement="R_SENT"><dc:Bounds x="352" y="185" width="36" height="50"/></bpmndi:BPMNShape>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
