<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Nooteboom" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude" exporterVersion="1.0">
<bpmn:collaboration id="Collaboration_1"><bpmn:participant id="Participant_1" name="Nooteboom · offerte → order" processRef="Process_Nooteboom"/></bpmn:collaboration>
<bpmn:process id="Process_Nooteboom" name="Offerte tot order" isExecutable="false">
<bpmn:documentation>Uitgewerkt uit workshop-swimlane 6-11-2026. Open punten: volgorde na Closed/Won afgeleid uit kolommen; rol Novis + 98/97 voor de order (&#x27;Volgende keer: ... → Novis offerte&#x27;) onduidelijk; vijfde lege lane weggelaten. Stap-sjabloon: input, output, rol, trigger, systeem, KPI?, status/aanpassing.</bpmn:documentation>
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_Salesforce" name="Salesforce"><bpmn:flowNodeRef>StartEvent_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_opp</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_knop</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_prod</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_prop</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_neg</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_won</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_so1</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_so2</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_osend</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_oprod</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_svc</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_end</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Tacton" name="Tacton"><bpmn:flowNodeRef>Activity_sol</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_offer</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_firm</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_send</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_rd</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_oo</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_oc</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Novis" name="Novis + 98/97"><bpmn:flowNodeRef>Activity_vo</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_voc</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_NAV" name="NAV"><bpmn:flowNodeRef>Activity_po</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="StartEvent_start" name="Start"><bpmn:documentation>Uitgangspunt: Contact of Account in SF van opportunity gewijzigd → sync naar Tacton → redesign in Tacton.</bpmn:documentation><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="Activity_opp" name="Opportunity aanmaken"><bpmn:documentation>Velden: Account, Contact, Close Date, Amount, Vehicle Type, Opportunity Name, Owner (+ enkele onleesbaar).</bpmn:documentation><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_knop" name="Knop “Tacton” (status: Needs Analysis)"><bpmn:documentation>Zet status op Needs Analysis. Notitie NAV-lane: &#x27;Naar Tacton knop: alles → sync&#x27;.</bpmn:documentation><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_sol" name="Opportunity / Solution – Product"><bpmn:documentation>Notities (deels onleesbaar): Tacton-opportunity → werkpakket(?) → revisie; product line items → prijs / korting(?).</bpmn:documentation><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_prod" name="Product (status: Needs Analysis)"></bpmn:task>
<bpmn:task id="Activity_offer" name="Create Offer"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_firm" name="Firm Ready"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_send" name="Send Proposal ? (“onder water”)"><bpmn:documentation>Op het bord met vraagtekens en &#x27;onder water&#x27; - open punt.</bpmn:documentation><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_prop" name="Opportunity (Proposal + doc. sturen)"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_neg" name="Opportunity (status: Negotiation)"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="Gateway_rd" name="Redesign?"><bpmn:documentation>Beslispunt tijdens onderhandeling; &#x27;wel&#x27; terug naar configuratie.</bpmn:documentation><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="Activity_won" name="Opportunity Closed → Won"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_oo" name="Open Order"><bpmn:documentation>Status Tacton: open order na omzetten naar Closed/Won.</bpmn:documentation><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_so1" name="Sales Order (status: Open Order)"></bpmn:task>
<bpmn:task id="Activity_vo" name="Open VO (verkooporder)"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_voc" name="Verkooporder compleet"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_oc" name="Order compleet"><bpmn:documentation>Notitie met pijlen (verkooporder, ... artikel) - niet goed leesbaar.</bpmn:documentation><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_so2" name="Sales Order (Complete + Download)"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_osend" name="Order send"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_oprod" name="Order productie"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_po" name="Productieorder"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:task>
<bpmn:task id="Activity_svc" name="Service artikel"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="EndEvent_end" name="Afgerond"><bpmn:incoming>Flow_22</bpmn:incoming></bpmn:endEvent>
