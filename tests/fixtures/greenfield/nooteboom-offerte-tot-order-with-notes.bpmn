<bpmn:sequenceFlow id="Flow_11" name="wel" sourceRef="Gateway_rd" targetRef="Activity_sol"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_won" targetRef="Activity_oo"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="Activity_oo" targetRef="Activity_vo"/>
