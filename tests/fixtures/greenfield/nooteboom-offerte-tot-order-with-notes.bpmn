<bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_voc" targetRef="Activity_oc"/>
<bpmn:sequenceFlow id="Flow_17" sourceRef="Activity_oc" targetRef="Activity_so2"/>
<bpmn:sequenceFlow id="Flow_18" sourceRef="Activity_so2" targetRef="Activity_osend"/>
<bpmn:sequenceFlow id="Flow_19" sourceRef="Activity_osend" targetRef="Activity_oprod"/>
