        <bpmn:flowNodeRef>frw_5_is</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_7_context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_19_dry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_10_fan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_17_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="external" name="Source project · External">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="ext" authority="external" height="80"/>
        </bpmn:extensionElements>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_trigger" name="Trigger — `fw harvest [project]`">
      <bpmn:extensionElements>
        <aef:uid value="n_start"/>
        <aef:position x="142.0" y="92.0"/>
        <aef:endpoint>fw harvest</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="frw_4_no" name="No such dir">
      <bpmn:extensionElements>
        <aef:uid value="n_no_dir"/>
        <aef:position x="523.0" y="493.5"/>
        <aef:meta terminalKind="error"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_6_refused" name="Refused (framework)">
      <bpmn:extensionElements>
        <aef:uid value="n_self"/>
        <aef:position x="653.0" y="493.5"/>
        <aef:meta terminalKind="error"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_8_no" name="No .context — init first">
      <bpmn:extensionElements>
        <aef:uid value="n_no_ctx"/>
        <aef:position x="793.0" y="493.5"/>
        <aef:meta terminalKind="error"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_22_dry" name="Dry-run — no changes">
      <bpmn:extensionElements>
        <aef:uid value="n_dry"/>
        <aef:position x="2146.1" y="514.5"/>
        <aef:meta terminalKind="success"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_25</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_23_nothing" name="Nothing new to harvest">
