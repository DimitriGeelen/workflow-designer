        <aef:position x="1905.0" y="277.5"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_27</bpmn:incoming>
      <bpmn:outgoing>flow_28</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="frw_3_dir" name="Dir exists?">
      <bpmn:extensionElements>
        <aef:uid value="n_exists_gate"/>
        <aef:position x="517.0" y="285.5"/>
        <aef:meta decisionOwner="framework"/>
        <aef:decisionInput>${cd project_dir}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="frw_5_is" name="Is framework itself?">
      <bpmn:extensionElements>
        <aef:uid value="n_self_gate"/>
        <aef:position x="647.0" y="285.5"/>
        <aef:meta decisionOwner="framework"/>
        <aef:decisionInput>${project_dir == FRAMEWORK_ROOT}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="frw_7_context" name=".context/project/ present?">
      <bpmn:extensionElements>
        <aef:uid value="n_ctx_gate"/>
        <aef:position x="787.0" y="285.5"/>
        <aef:meta decisionOwner="framework"/>
        <aef:decisionInput>${-d project/.context/project}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="frw_19_dry" name="dry-run? new items?">
      <bpmn:extensionElements>
        <aef:uid value="n_mode_gate"/>
        <aef:position x="1816.0" y="386.5"/>
        <aef:meta decisionOwner="framework"/>
        <aef:decisionInput>${dry_run -&gt; dry; new_total&gt;0 -&gt; write; else nothing}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_24</bpmn:incoming>
      <bpmn:outgoing>flow_25</bpmn:outgoing>
      <bpmn:outgoing>flow_26</bpmn:outgoing>
      <bpmn:outgoing>flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="frw_10_fan" name="Fan out — 6 memory categories">
      <bpmn:extensionElements>
        <aef:uid value="n_fork"/>
        <aef:position x="1016.0" y="386.5"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
