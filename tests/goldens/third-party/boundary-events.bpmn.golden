      <bpmndi:BPMNShape id="BPMNShape_hum_6_superman" bpmnElement="hum_6_superman">
        <dc:Bounds x="781.0" y="140.0" width="110" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_hum_5_wonder" bpmnElement="hum_5_wonder">
