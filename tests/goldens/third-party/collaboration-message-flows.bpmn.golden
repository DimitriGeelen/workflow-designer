<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_process_1"
                  exporter="aef-workflow-designer"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_process_1">
    <bpmn:participant id="Participant_2" name="Pool" processRef="Process_process_1"/>
    <bpmn2:participant xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Participant_1" name="Pool" processRef="Process_2"/>
    <bpmn2:messageFlow xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" id="MessageFlow_1" name="" sourceRef="lan_2_task" targetRef="Participant_1"/>
    <bpmn2:messageFlow xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" id="MessageFlow_2" name="" sourceRef="Participant_1" targetRef="Participant_2"/>
    <bpmn2:messageFlow xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" id="MessageFlow_4" name="" sourceRef="lan_1_task" targetRef="StartEvent_1"/>
    <bpmn2:messageFlow xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" id="MessageFlow_5" name="" sourceRef="lan_3_endevent" targetRef="Participant_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_process_1" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="process_1" version="1" schemaVersion="2" title="Process_1" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="130"/>
        </bpmn:extensionElements>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="130"/>
        </bpmn:extensionElements>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="320"/>
        </bpmn:extensionElements>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:endEvent id="lan_3_endevent" name="EndEvent_1">
      <bpmn:extensionElements>
        <aef:uid value="u1"/>
        <aef:position x="653.0" y="178.0"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>

    <bpmn:task id="lan_1_task" name="Task_1">
      <bpmn:extensionElements>
        <aef:uid value="u2"/>
        <aef:position x="360.0" y="134.0"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="lan_2_task" name="Task_2">
      <bpmn:extensionElements>
        <aef:uid value="u3"/>
        <aef:position x="516.0" y="134.0"/>
      </bpmn:extensionElements>
    </bpmn:task>
  </bpmn:process>

  <bpmn2:process xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Process_2" isExecutable="false">
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:messageEventDefinition id="MessageEventDefinition_1"/>
    </bpmn2:startEvent>
  </bpmn2:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_process_1" bpmnElement="Collaboration_process_1">
      <bpmndi:BPMNShape id="BPMNShape_Participant_2" bpmnElement="Participant_2" isHorizontal="true">
        <dc:Bounds x="30" y="30" width="1540" height="612"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lan_3_endevent" bpmnElement="lan_3_endevent">
        <dc:Bounds x="653.0" y="178.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lan_1_task" bpmnElement="lan_1_task">
        <dc:Bounds x="360.0" y="134.0" width="110" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lan_2_task" bpmnElement="lan_2_task">
        <dc:Bounds x="516.0" y="134.0" width="110" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_Participant_3" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="30" y="682" width="1540" height="100"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_3" bpmnElement="StartEvent_1"><dc:Bounds x="108" y="715" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_MessageFlow_1" bpmnElement="MessageFlow_1"><di:waypoint x="571" y="198"/><di:waypoint x="571" y="682"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_MessageFlow_2" bpmnElement="MessageFlow_2"><di:waypoint x="800" y="682"/><di:waypoint x="800" y="642"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_MessageFlow_4" bpmnElement="MessageFlow_4"><di:waypoint x="415" y="198"/><di:waypoint x="415" y="457"/><di:waypoint x="126" y="457"/><di:waypoint x="126" y="715"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_MessageFlow_5" bpmnElement="MessageFlow_5"><di:waypoint x="671" y="214"/><di:waypoint x="671" y="682"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>