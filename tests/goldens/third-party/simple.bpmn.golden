<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="simple"
                  exporter="aef-workflow-designer"
                  targetNamespace="http://bpmn.io/schema/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">

  <bpmn:collaboration id="Collaboration_process_1">
    <bpmn:participant id="Pool_process_1" name="Process_1" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:extensionElements>
      <aef:workflowMeta id="process_1" version="1" schemaVersion="2" title="Process_1" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="130"/>
        </bpmn:extensionElements>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="130"/>
        </bpmn:extensionElements>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="320"/>
        </bpmn:extensionElements>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:subProcess id="lan_1_sub" name="Sub Process 1">
      <bpmn:extensionElements>
        <aef:uid value="u1"/>
        <aef:position x="300.0" y="80.0"/>
        <x832:origin xmlns:x832="urn:832-workflow-designer:origin:1" originalId="SubProcess_1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>

      <bpmn:startEvent id="lan_start_start_2" name="Start Event 1">
        <bpmn:extensionElements>
        <aef:uid value="u2"/>
        <aef:position x="352.0" y="242.0"/>
        <x832:origin xmlns:x832="urn:832-workflow-designer:origin:1" originalId="StartEvent_1"/>
      </bpmn:extensionElements>
        <bpmn:outgoing>flow_1</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:task id="lan_2_task" name="Task">
        <bpmn:extensionElements>
        <aef:uid value="u3"/>
        <aef:position x="420.0" y="220.0"/>
        <x832:origin xmlns:x832="urn:832-workflow-designer:origin:1" originalId="Task_1"/>
      </bpmn:extensionElements>
        <bpmn:incoming>flow_1</bpmn:incoming>
      </bpmn:task>

      <bpmn:sequenceFlow id="flow_1" sourceRef="lan_start_start_2" targetRef="lan_2_task">
        <bpmn:extensionElements>
          <aef:uid value="u4"/>
          <x832:origin xmlns:x832="urn:832-workflow-designer:origin:1" originalId="SequenceFlow_1"/>
        </bpmn:extensionElements>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>

    <bpmn:endEvent id="lan_end_end" name="End Event">
      <bpmn:extensionElements>
        <aef:uid value="u5"/>
        <aef:position x="650.0" y="212.0"/>
        <x832:origin xmlns:x832="urn:832-workflow-designer:origin:1" originalId="EndEvent_1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:startEvent id="lan_start_start" name="Start">
      <bpmn:extensionElements>
        <aef:uid value="u6"/>
        <aef:position x="108.0" y="212.0"/>
        <x832:origin xmlns:x832="urn:832-workflow-designer:origin:1" originalId="StartEvent_2"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="flow_2" sourceRef="lan_1_sub" targetRef="lan_end_end">
      <bpmn:extensionElements>
        <aef:uid value="u7"/>
        <x832:origin xmlns:x832="urn:832-workflow-designer:origin:1" originalId="SequenceFlow_2"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="Flow" sourceRef="lan_start_start" targetRef="lan_1_sub">
      <bpmn:extensionElements>
        <aef:uid value="u8"/>
        <x832:origin xmlns:x832="urn:832-workflow-designer:origin:1" originalId="SequenceFlow_3"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="_BPMNShape_SubProcess_2" bpmnElement="lan_1_sub" isExpanded="true">
        <dc:Bounds x="300.0" y="80.0" width="300.0" height="300.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="lan_start_start_2">
        <dc:Bounds x="352.0" y="242.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="345" y="285" width="55" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_Task_2" bpmnElement="lan_2_task">
        <dc:Bounds x="420.0" y="220.0" width="100.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_EndEvent_2" bpmnElement="lan_end_end">
        <dc:Bounds x="650.0" y="212.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="645" y="255" width="51" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_11" bpmnElement="lan_start_start">
        <dc:Bounds x="108.0" y="212.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" height="0.0" width="0.0" x="126.0" y="253.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_1" bpmnElement="flow_1" sourceElement="_BPMNShape_StartEvent_2" targetElement="_BPMNShape_Task_2">
        <di:waypoint x="388.0" y="260.0"/>
        <di:waypoint x="420.0" y="260.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_2" bpmnElement="flow_2" sourceElement="_BPMNShape_SubProcess_2" targetElement="_BPMNShape_EndEvent_2">
        <di:waypoint x="600.0" y="230.0"/>
        <di:waypoint x="650.0" y="230.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_3" bpmnElement="flow_3" sourceElement="_BPMNShape_StartEvent_11" targetElement="_BPMNShape_SubProcess_2">
        <di:waypoint x="144.0" y="230.0"/>
        <di:waypoint x="300.0" y="230.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" height="21.0" width="33.0" x="192.0" y="204.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>