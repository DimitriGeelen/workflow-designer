<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_error-escalation-ladder"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_error-escalation-ladder">
    <bpmn:participant id="Pool_error_escalation_ladder" name="error-escalation-ladder" processRef="Process_error-escalation-ladder"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_error-escalation-ladder" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="error-escalation-ladder" version="2" schemaVersion="2" title="error-escalation-ladder" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="agent" name="Agent · Initiative (judgement + action)">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="512.8942297153835"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_proactive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_13_resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_11_doctrine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_3_doctrine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_7_doctrine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_8_doctrine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_9_doctrine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_10_doctrine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_12_healing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_5_code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_6_doctrine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_4_doctrine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority (healing agent, code)">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="180"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_1_code</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_error" name="Error / unexpected behavior">
      <bpmn:extensionElements>
        <aef:uid value="n_failure"/>
        <aef:position x="142.0" y="96.5"/>
        <aef:meta triggeredBy="agent hits error or human reports it"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="agt_2_proactive" name="Proactive: practice repeats 3+ tasks (no failure)">
      <bpmn:extensionElements>
        <aef:uid value="n_reflect"/>
        <aef:position x="187.6" y="424.5"/>
        <aef:meta triggeredBy="organic &quot;how do we do X?&quot; + 3+ episodic instances (CLAUDE.md)"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="agt_13_resolved" name="resolved + pattern learned">
      <bpmn:extensionElements>
        <aef:uid value="n_done"/>
        <aef:position x="1382.0" y="502.0"/>
        <aef:meta note="v2 (T-298): return to started-work is a PRINTED next-step (diagnose.sh:208, resolve.sh:155), not an automatic transition — pattern+learning capture is what resolve actually does"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="agt_11_doctrine" name="[DOCTRINE] defer — not yet worth codifying">
      <bpmn:extensionElements>
        <aef:uid value="n_defer"/>
        <aef:position x="834.9" y="502.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_16</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="agt_3_doctrine" name="[DOCTRINE] set status=issues (auto-triggers diagnose)">
      <bpmn:extensionElements>
        <aef:uid value="n_issues"/>
        <aef:position x="225.0" y="82.5"/>
        <aef:endpoint>fw task update T-XXX --status issues</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_7_doctrine" name="[DOCTRINE] A: don't repeat — apply known mitigation">
      <bpmn:extensionElements>
        <aef:uid value="n_a"/>
        <aef:position x="797.9" y="77.4"/>
        <aef:contextReads paths=".context/project/patterns.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_8_doctrine" name="[DOCTRINE] B: improve technique">
      <bpmn:extensionElements>
        <aef:uid value="n_b"/>
        <aef:position x="797.9" y="157.4"/>
        <aef:endpoint>type-specific suggestions (diagnose.sh:164-195)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_9_doctrine" name="[DOCTRINE] C: improve tooling (add check / audit rule)">
      <bpmn:extensionElements>
        <aef:uid value="n_c"/>
        <aef:position x="797.9" y="237.4"/>
        <aef:endpoint>add automated check; update audit agent (diagnose.sh:197-199)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_10_doctrine" name="[DOCTRINE] D: change ways of working / codify">
      <bpmn:extensionElements>
        <aef:uid value="n_d"/>
        <aef:position x="797.9" y="311.9"/>
        <aef:endpoint>new practice / protocol in CLAUDE.md (diagnose.sh:201-203)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_12_healing" name="healing resolve --mitigation">
      <bpmn:extensionElements>
        <aef:uid value="n_resolve"/>
        <aef:position x="1071.2" y="180.7"/>
        <aef:endpoint>fw healing resolve T-XXX --mitigation "what fixed it"</aef:endpoint>
        <aef:meta note="v2 (T-298): reachability ADVISORY — nothing auto-invokes resolve after a rung is applied; diagnose only PRINTS the resolve step (diagnose.sh:209). Same leak class as healing-loop v2 (AEF G-016: 72% of bugfix tasks record zero learnings)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:scriptTask id="agt_5_code" name="[CODE] diagnose: classify + lookup + A/B/C/D menu">
      <bpmn:extensionElements>
        <aef:uid value="n_diagnose"/>
        <aef:position x="425.0" y="82.5"/>
        <aef:meta tier="1" agentType="framework"/>
        <aef:endpoint>agents/healing/lib/diagnose.sh:23-204</aef:endpoint>
        <aef:contextReads paths=".context/project/patterns.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_1_code" name="[CODE] resolve + promote: log pattern/learning, graduate">
      <bpmn:extensionElements>
        <aef:uid value="n_capture"/>
        <aef:position x="1151.2" y="632.9"/>
        <aef:meta tier="1" agentType="framework"/>
        <aef:endpoint>agents/healing/lib/resolve.sh (log) + lib/promote.sh / lib/harvest.sh (graduate 3+ apps)</aef:endpoint>
        <aef:artifactsWrites paths=".context/project/patterns.yaml, .context/project/learnings.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="agt_6_doctrine" name="[DOCTRINE] which rung? escalate on recurrence">
      <bpmn:extensionElements>
        <aef:uid value="g_ladder"/>
        <aef:position x="536.0" y="165.4"/>
        <aef:meta decisionOwner="agent"/>
        <aef:decisionInput>${same_class_hits}</aef:decisionInput>
        <aef:decisionOutputs>A-dont-repeat, B-technique, C-tooling, D-ways-of-working</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="agt_4_doctrine" name="[DOCTRINE] mine episodic -&gt; codification value?">
      <bpmn:extensionElements>
        <aef:uid value="g_assess"/>
        <aef:position x="289.5" y="413.5"/>
        <aef:meta decisionOwner="agent"/>
        <aef:decisionInput>${inception_go_no_go_criteria}</aef:decisionInput>
        <aef:decisionOutputs>worth-codifying, defer</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_1_error" targetRef="agt_3_doctrine">
      <bpmn:extensionElements>
        <aef:uid value="e_01"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" name="auto-trigger diagnose" sourceRef="agt_3_doctrine" targetRef="agt_5_code">
      <bpmn:extensionElements>
        <aef:uid value="e_02"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="suggestion menu -&gt; agent decides" sourceRef="agt_5_code" targetRef="agt_6_doctrine">
      <bpmn:extensionElements>
        <aef:uid value="e_03"/>
        <aef:anchors sourcePort="S"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" name="1st occurrence" sourceRef="agt_6_doctrine" targetRef="agt_7_doctrine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${same_class_hits &lt;= 1}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_04"/>
        <aef:anchors sourcePort="N"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" name="technique gap" sourceRef="agt_6_doctrine" targetRef="agt_8_doctrine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${technique_fixable}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_05"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" name="same class 2+ times" sourceRef="agt_6_doctrine" targetRef="agt_9_doctrine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${same_class_hits &gt;= 2}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_06"/>
        <aef:anchors sourcePort="SE"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" name="systemic" sourceRef="agt_6_doctrine" targetRef="agt_10_doctrine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${systemic}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_07"/>
        <aef:anchors sourcePort="SE"/>
        <aef:routingHint role="seg_first" offset="1.3"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" sourceRef="agt_7_doctrine" targetRef="agt_12_healing">
      <bpmn:extensionElements>
        <aef:uid value="e_08"/>
        <aef:anchors targetPort="N"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" sourceRef="agt_8_doctrine" targetRef="agt_12_healing">
      <bpmn:extensionElements>
        <aef:uid value="e_09"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" sourceRef="agt_9_doctrine" targetRef="agt_12_healing">
      <bpmn:extensionElements>
        <aef:uid value="e_10"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_11" sourceRef="agt_10_doctrine" targetRef="agt_12_healing">
      <bpmn:extensionElements>
        <aef:uid value="e_11"/>
        <aef:anchors targetPort="S"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_12" name="log resolution" sourceRef="agt_12_healing" targetRef="frw_1_code">
      <bpmn:extensionElements>
        <aef:uid value="e_12"/>
        <aef:anchors sourcePort="E"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_13" sourceRef="frw_1_code" targetRef="agt_13_resolved">
      <bpmn:extensionElements>
        <aef:uid value="e_13"/>
        <aef:anchors sourcePort="E" targetPort="S"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_14" sourceRef="agt_2_proactive" targetRef="agt_4_doctrine">
      <bpmn:extensionElements>
        <aef:uid value="e_14"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_15" name="worth codifying -&gt; Level D" sourceRef="agt_4_doctrine" targetRef="agt_10_doctrine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${worth_codifying}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_15"/>
        <aef:anchors targetPort="S"/>
        <aef:routingHint role="seg_mid" offset="50.1"/>
        <aef:routingHint role="seg_first" offset="-0.6"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_16" name="defer" sourceRef="agt_4_doctrine" targetRef="agt_11_doctrine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${!worth_codifying}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_16"/>
        <aef:anchors sourcePort="N"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>