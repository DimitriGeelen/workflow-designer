<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_session-handover"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_session-handover">
    <bpmn:participant id="Pool_session_handover" name="session-handover" processRef="Process_session-handover"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_session-handover" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="session-handover" uuid="6f1094d1-3fc2-4288-9a89-804d32ff7ccd" version="1" schemaVersion="2" title="session-handover" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="80"/>
        </bpmn:extensionElements>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="216"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_9_handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_1_gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_2_backfill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_4_extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_5_write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_6_auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_7_pre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_8_push</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_3_all</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="96"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_session</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_session" name="Session end / checkpoint requested">
      <bpmn:extensionElements>
        <aef:uid value="n_trigger"/>
        <aef:position x="120.0" y="388.0"/>
        <aef:meta triggeredBy="fw handover [--commit] | PreCompact hook"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="frw_9_handover" name="Handover published (next session can resume)">
      <bpmn:extensionElements>
        <aef:uid value="n_end"/>
        <aef:position x="1720.0" y="286.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:scriptTask id="frw_1_gather" name="Gather state (git, tasks, focus, session)">
      <bpmn:extensionElements>
        <aef:uid value="n_gather"/>
        <aef:position x="320.0" y="272.0"/>
        <aef:meta tier="1"/>
        <aef:contextReads paths="git status, .tasks/, focus.yaml"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_2_backfill" name="Backfill missing episodics (warn)">
      <bpmn:extensionElements>
        <aef:uid value="n_enrich"/>
        <aef:position x="520.0" y="164.0"/>
        <aef:meta tier="1"/>
        <aef:endpoint>context.sh generate-episodic</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_4_extract" name="Extract session metrics">
      <bpmn:extensionElements>
        <aef:uid value="n_metrics"/>
        <aef:position x="720.0" y="272.0"/>
        <aef:meta tier="1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_5_write" name="Write handover doc + LATEST.md (Where We Are, Suggested Action)">
      <bpmn:extensionElements>
        <aef:uid value="n_write"/>
        <aef:position x="920.0" y="272.0"/>
        <aef:meta tier="1"/>
        <aef:artifactsWrites paths="['.context/handovers/${session}.md', 'LATEST.md']"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_6_auto" name="Auto-commit via git agent">
      <bpmn:extensionElements>
        <aef:uid value="n_commit"/>
        <aef:position x="1120.0" y="272.0"/>
        <aef:meta tier="1"/>
        <aef:endpoint>git agent commit -m "&lt;task&gt;: Checkpoint handover"</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_7_pre" name="Pre-push audit check">
      <bpmn:extensionElements>
        <aef:uid value="n_audit"/>
        <aef:position x="1320.0" y="272.0"/>
        <aef:meta tier="1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_8_push" name="Push to remotes">
      <bpmn:extensionElements>
        <aef:uid value="n_push"/>
        <aef:position x="1520.0" y="272.0"/>
        <aef:meta tier="1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="frw_3_all" name="All completed tasks have enriched episodics?">
      <bpmn:extensionElements>
        <aef:uid value="n_episodic_gate"/>
        <aef:position x="520.0" y="280.0"/>
        <aef:meta decisionOwner="framework"/>
        <aef:decisionInput>${episodics_complete}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_1_session" targetRef="frw_1_gather">
      <bpmn:extensionElements>
        <aef:uid value="e_01"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" sourceRef="frw_1_gather" targetRef="frw_3_all">
      <bpmn:extensionElements>
        <aef:uid value="e_02"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="missing episodics" sourceRef="frw_3_all" targetRef="frw_2_backfill">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${episodics_complete == false}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_03"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" name="complete" sourceRef="frw_3_all" targetRef="frw_4_extract">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${episodics_complete == true}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_04"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" sourceRef="frw_2_backfill" targetRef="frw_4_extract">
      <bpmn:extensionElements>
        <aef:uid value="e_05"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" sourceRef="frw_4_extract" targetRef="frw_5_write">
      <bpmn:extensionElements>
        <aef:uid value="e_06"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" sourceRef="frw_5_write" targetRef="frw_6_auto">
      <bpmn:extensionElements>
        <aef:uid value="e_07"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" sourceRef="frw_6_auto" targetRef="frw_7_pre">
      <bpmn:extensionElements>
        <aef:uid value="e_08"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" sourceRef="frw_7_pre" targetRef="frw_8_push">
      <bpmn:extensionElements>
        <aef:uid value="e_09"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" sourceRef="frw_8_push" targetRef="frw_9_handover">
      <bpmn:extensionElements>
        <aef:uid value="e_10"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>