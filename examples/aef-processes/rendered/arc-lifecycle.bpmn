<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated from arc-lifecycle by tools/yaml-to-bpmn.py. Do not edit by hand. -->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:aef="http://anchorpoint.framework/aef/extensions"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="Pool_arc_lifecycle" name="arc-lifecycle">

    <bpmn:laneSet id="LaneSet_arc-lifecycle">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="160"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>n_approve_driver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_close_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_route</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="220"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>n_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_abandon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_abandoned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="220"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>n_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_tag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_bvp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="n_req" name="Arc proposed (headline mechanic identified)">
      <bpmn:extensionElements>
        <aef:uid value="n_req"/>
        <aef:position x="120" y="560"/>
        <aef:meta triggeredBy="fw arc create &lt;id&gt; --name --headline-mechanic"/>
        <aef:io>
          <aef:output name="headline_mechanic" type="string"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:outgoing>e_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="n_create" name="Create arc (status draft, immutable arc-NNN)">
      <bpmn:extensionElements>
        <aef:uid value="n_create"/>
        <aef:position x="300" y="560"/>
        <aef:meta determinism="deterministic" tier="1" endpoint="lib/arc.sh:344" state="draft"/>
        <aef:artifactsWrites paths=".context/arcs/&lt;slug&gt;.yaml"/>
        <aef:io>
          <aef:output name="arc_id" type="string"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:incoming>e_01</bpmn:incoming>
      <bpmn:outgoing>e_02</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="n_start" name="Start arc (draft → in-progress)">
      <bpmn:extensionElements>
        <aef:uid value="n_start"/>
        <aef:position x="480" y="560"/>
        <aef:meta determinism="deterministic" tier="1" endpoint="fw arc start ${arc_id}" state="in-progress"/>
      </bpmn:extensionElements>
      <bpmn:incoming>e_02</bpmn:incoming>
      <bpmn:outgoing>e_03</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="n_tag" name="Tag member tasks (arc_id / arc: tag)">
      <bpmn:extensionElements>
        <aef:uid value="n_tag"/>
        <aef:position x="660" y="560"/>
        <aef:meta determinism="deterministic" tier="1" endpoint="fw arc tag ${arc_id} T-XXXX" gate="check-arc-id.py (arc_id must resolve; else block exit 2)" x-grouping="kind=tag-set; membership=computed; ordered=false"/>
        <aef:io>
          <aef:output name="members" type="computed-set"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:incoming>e_03</bpmn:incoming>
      <bpmn:outgoing>e_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_bvp" name="BVP rescore (writes PROPOSED scores only)">
      <bpmn:extensionElements>
        <aef:uid value="n_bvp"/>
        <aef:position x="840" y="560"/>
        <aef:meta determinism="stochastic" tier="1" endpoint="fw arc rescore ${arc_id}" advisory="True"/>
      </bpmn:extensionElements>
      <bpmn:incoming>e_04</bpmn:incoming>
      <bpmn:outgoing>e_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="n_approve_driver" name="Approve value drivers (human-only)">
      <bpmn:extensionElements>
        <aef:uid value="n_approve_driver"/>
        <aef:position x="1040" y="110"/>
        <aef:meta determinism="human" tier="0" authority="sovereignty" endpoint="fw arc approve-driver ${arc_id} --i-am-human"/>
      </bpmn:extensionElements>
      <bpmn:incoming>e_05</bpmn:incoming>
      <bpmn:outgoing>e_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="n_work" name="Work member tasks (each = own task-lifecycle + Evolution log)">
      <bpmn:extensionElements>
        <aef:uid value="n_work"/>
        <aef:position x="1240" y="560"/>
        <aef:meta determinism="stochastic" tier="2" x-subProcessPerMember="task-lifecycle" x-groupConstraint="evolution-log required on every member (evolution_log.sh:86)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>e_06</bpmn:incoming>
      <bpmn:outgoing>e_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="n_review" name="Emit close review surface (Watchtower URL + QR)">
      <bpmn:extensionElements>
        <aef:uid value="n_review"/>
        <aef:position x="1420" y="560"/>
        <aef:meta determinism="deterministic" tier="1" endpoint="fw arc review ${arc_id}"/>
      </bpmn:extensionElements>
      <bpmn:incoming>e_07</bpmn:incoming>
      <bpmn:outgoing>e_08</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="n_close_decide" name="Close or abandon? (human-only)">
      <bpmn:extensionElements>
        <aef:uid value="n_close_decide"/>
        <aef:position x="1600" y="110"/>
        <aef:meta determinism="human" tier="0" authority="sovereignty" endpoint="watchtower:/arcs/${arc_id}/close  |  fw arc close --i-am-human" x-requiresForClose="demo_evidence (path|url)"/>
        <aef:decisionOutputs>close, abandon</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>e_08</bpmn:incoming>
      <bpmn:outgoing>e_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="n_route" name="Close or abandon?">
      <bpmn:extensionElements>
        <aef:uid value="n_route"/>
        <aef:position x="1780" y="110"/>
        <aef:meta decisionOwner="human"/>
        <aef:decisionInput>${decision}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>e_09</bpmn:incoming>
      <bpmn:outgoing>e_10</bpmn:outgoing>
      <bpmn:outgoing>e_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="n_close" name="Close arc (in-progress → closed) + record demo_evidence">
      <bpmn:extensionElements>
        <aef:uid value="n_close"/>
        <aef:position x="1960" y="300"/>
        <aef:meta determinism="deterministic" tier="1" endpoint="lib/arc.sh:643" state="closed" note="immutable — arc YAML never moved/deleted (F6)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>e_10</bpmn:incoming>
      <bpmn:outgoing>e_12</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="n_abandon" name="Abandon arc (reason ≥30 chars)">
      <bpmn:extensionElements>
        <aef:uid value="n_abandon"/>
        <aef:position x="1960" y="370"/>
        <aef:meta determinism="deterministic" tier="1" endpoint="lib/arc.sh:770" state="abandoned" note="side exit reachable from draft or in-progress too"/>
      </bpmn:extensionElements>
      <bpmn:incoming>e_11</bpmn:incoming>
      <bpmn:outgoing>e_13</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="n_end_closed" name="Arc closed (immutable)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_closed"/>
        <aef:position x="2160" y="300"/>
      </bpmn:extensionElements>
      <bpmn:incoming>e_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="n_end_abandoned" name="Arc abandoned (immutable)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_abandoned"/>
        <aef:position x="2160" y="398"/>
      </bpmn:extensionElements>
      <bpmn:incoming>e_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="e_01" sourceRef="n_req" targetRef="n_create">
      <bpmn:extensionElements><aef:uid value="e_01"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_02" sourceRef="n_create" targetRef="n_start">
      <bpmn:extensionElements><aef:uid value="e_02"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_03" sourceRef="n_start" targetRef="n_tag">
      <bpmn:extensionElements><aef:uid value="e_03"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_04" sourceRef="n_tag" targetRef="n_bvp">
      <bpmn:extensionElements><aef:uid value="e_04"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_05" sourceRef="n_bvp" targetRef="n_approve_driver">
      <bpmn:extensionElements><aef:uid value="e_05"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_06" sourceRef="n_approve_driver" targetRef="n_work">
      <bpmn:extensionElements><aef:uid value="e_06"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_07" sourceRef="n_work" targetRef="n_review">
      <bpmn:extensionElements><aef:uid value="e_07"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_08" sourceRef="n_review" targetRef="n_close_decide">
      <bpmn:extensionElements><aef:uid value="e_08"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_09" sourceRef="n_close_decide" targetRef="n_route">
      <bpmn:extensionElements><aef:uid value="e_09"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_10" name="close (demo evidence)" sourceRef="n_route" targetRef="n_close">
      <bpmn:extensionElements><aef:uid value="e_10"/></bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'close'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_11" name="abandon" sourceRef="n_route" targetRef="n_abandon">
      <bpmn:extensionElements><aef:uid value="e_11"/></bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'abandon'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_12" sourceRef="n_close" targetRef="n_end_closed">
      <bpmn:extensionElements><aef:uid value="e_12"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_13" sourceRef="n_abandon" targetRef="n_end_abandoned">
      <bpmn:extensionElements><aef:uid value="e_13"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>
