    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_04" sourceRef="n_suggest" targetRef="n_acted">
      <bpmn:extensionElements><aef:uid value="e_04"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_05" name="acts on advice" sourceRef="n_acted" targetRef="n_choose">
      <bpmn:extensionElements><aef:uid value="e_05"/></bpmn:extensionElements>
