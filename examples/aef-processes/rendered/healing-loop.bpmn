    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_06" name="advisory only" sourceRef="n_acted" targetRef="n_end_advisory">
      <bpmn:extensionElements><aef:uid value="e_06"/></bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${act == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_07" sourceRef="n_choose" targetRef="n_apply">
      <bpmn:extensionElements><aef:uid value="e_07"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_08" sourceRef="n_apply" targetRef="n_resolve">
      <bpmn:extensionElements><aef:uid value="e_08"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_09" sourceRef="n_resolve" targetRef="n_resume">
      <bpmn:extensionElements><aef:uid value="e_09"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_10" sourceRef="n_resume" targetRef="n_end_resolved">
      <bpmn:extensionElements><aef:uid value="e_10"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>
