    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e5" sourceRef="n_scan" targetRef="g_card">
      <bpmn:extensionElements><aef:uid value="e5"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e6" name="has card" sourceRef="g_card" targetRef="n_writes">
      <bpmn:extensionElements><aef:uid value="e6"/></bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">card_found</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e7" name="no card" sourceRef="g_card" targetRef="n_nocard">
      <bpmn:extensionElements><aef:uid value="e7"/></bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">!card_found</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e8" sourceRef="n_writes" targetRef="n_total">
      <bpmn:extensionElements><aef:uid value="e8"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e9" sourceRef="n_nocard" targetRef="n_total">
      <bpmn:extensionElements><aef:uid value="e9"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e10" sourceRef="n_total" targetRef="n_done">
      <bpmn:extensionElements><aef:uid value="e10"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>
