<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_upgrade-process"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_upgrade-process">
    <bpmn:participant id="Pool_upgrade_process" name="upgrade-process" processRef="Process_upgrade-process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_upgrade-process" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="upgrade-process" uuid="fa213bfe-8608-43b4-a29c-7926f22d053d" version="1" schemaVersion="2" title="upgrade-process" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="80"/>
        </bpmn:extensionElements>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="480"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_11_upgrade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_12_upgrade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_5_preview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_3_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_2_snapshot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_4_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_6_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_7_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_10_rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_9_cleanup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_1_dry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_8_upgrade</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="96"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_upgrade</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_upgrade" name="Upgrade requested">
      <bpmn:extensionElements>
        <aef:uid value="n_trigger"/>
        <aef:position x="120.0" y="652.0"/>
        <aef:meta triggeredBy="fw upgrade [--dry-run]"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="frw_11_upgrade" name="Upgrade applied">
      <bpmn:extensionElements>
        <aef:uid value="n_end_done"/>
        <aef:position x="1720.0" y="268.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_12_upgrade" name="Upgrade rolled back (restored)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_rolledback"/>
        <aef:position x="1720.0" y="460.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_5_preview" name="Preview reported (no changes)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_preview"/>
        <aef:position x="720.0" y="172.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:scriptTask id="frw_3_report" name="Report planned changes (no mutation)">
      <bpmn:extensionElements>
        <aef:uid value="n_preview"/>
        <aef:position x="520.0" y="154.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_2_snapshot" name="Snapshot — timestamped .bak of settings/CLAUDE.md/hooks">
      <bpmn:extensionElements>
        <aef:uid value="n_backup"/>
        <aef:position x="520.0" y="372.0"/>
        <aef:endpoint>cp &lt;target&gt; &lt;target&gt;.bak-$(date +%s)</aef:endpoint>
        <aef:artifactsWrites paths="['*.bak-&lt;ts&gt;']"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_4_apply" name="Apply — merge settings.json (drift-gated)">
      <bpmn:extensionElements>
        <aef:uid value="n_apply_settings"/>
        <aef:position x="720.0" y="350.0"/>
        <aef:meta guard="apply only on drift (per-file compare)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_6_apply" name="Apply — install git hooks + commands/scripts (drift-gated)">
      <bpmn:extensionElements>
        <aef:uid value="n_apply_hooks"/>
        <aef:position x="920.0" y="350.0"/>
        <aef:meta guard="apply only on drift (per-file compare)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_7_verify" name="Verify — version + drift check">
      <bpmn:extensionElements>
        <aef:uid value="n_verify"/>
        <aef:position x="1120.0" y="350.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_10_rollback" name="Rollback — restore from .bak snapshot">
      <bpmn:extensionElements>
        <aef:uid value="n_rollback"/>
        <aef:position x="1520.0" y="538.0"/>
        <aef:endpoint>restore &lt;target&gt; from &lt;target&gt;.bak-&lt;ts&gt;</aef:endpoint>
        <aef:compensates>
          <aef:compensate ref="n_apply_settings"/>
          <aef:compensate ref="n_apply_hooks"/>
        </aef:compensates>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_9_cleanup" name="Cleanup — drop stale .bak, record new VERSION">
      <bpmn:extensionElements>
        <aef:uid value="n_cleanup"/>
        <aef:position x="1520.0" y="280.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="frw_1_dry" name="Dry-run mode?">
      <bpmn:extensionElements>
        <aef:uid value="n_mode"/>
        <aef:position x="320.0" y="358.0"/>
        <aef:meta decisionOwner="framework"/>
        <aef:decisionInput>${dry_run}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="frw_8_upgrade" name="Upgrade verified OK?">
      <bpmn:extensionElements>
        <aef:uid value="n_ok"/>
        <aef:position x="1320.0" y="358.0"/>
        <aef:meta decisionOwner="framework"/>
        <aef:decisionInput>${verify_ok}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_1_upgrade" targetRef="frw_1_dry">
      <bpmn:extensionElements>
        <aef:uid value="e_trigger_mode"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" name="dry-run" sourceRef="frw_1_dry" targetRef="frw_3_report">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${dry_run == true}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_mode_preview"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="apply" sourceRef="frw_1_dry" targetRef="frw_2_snapshot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${dry_run == false}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_mode_apply"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" sourceRef="frw_3_report" targetRef="frw_5_preview">
      <bpmn:extensionElements>
        <aef:uid value="e_preview_end"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" sourceRef="frw_2_snapshot" targetRef="frw_4_apply">
      <bpmn:extensionElements>
        <aef:uid value="e_backup_settings"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" sourceRef="frw_4_apply" targetRef="frw_6_apply">
      <bpmn:extensionElements>
        <aef:uid value="e_settings_hooks"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" sourceRef="frw_6_apply" targetRef="frw_7_verify">
      <bpmn:extensionElements>
        <aef:uid value="e_hooks_verify"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" sourceRef="frw_7_verify" targetRef="frw_8_upgrade">
      <bpmn:extensionElements>
        <aef:uid value="e_verify_ok"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" name="verified" sourceRef="frw_8_upgrade" targetRef="frw_9_cleanup">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${verify_ok == true}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_ok_cleanup"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" name="failed → compensate" sourceRef="frw_8_upgrade" targetRef="frw_10_rollback">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${verify_ok == false}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_ok_rollback"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_11" sourceRef="frw_9_cleanup" targetRef="frw_11_upgrade">
      <bpmn:extensionElements>
        <aef:uid value="e_cleanup_end"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_12" sourceRef="frw_10_rollback" targetRef="frw_12_upgrade">
      <bpmn:extensionElements>
        <aef:uid value="e_rollback_end"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>