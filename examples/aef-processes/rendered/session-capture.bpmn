        <aef:meta determinism="deterministic" tier="1" endpoint="AGENT.md:38-40 (checklist capture lines)" note="FC-11 collapse — four capture actions, one node; constituents in x-captures" x-captures="create task per work item; update tasks with new context; capture learnings as practices; log open questions"/>
