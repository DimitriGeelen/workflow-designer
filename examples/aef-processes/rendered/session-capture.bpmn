<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_session-capture"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_session-capture">
    <bpmn:participant id="Pool_session_capture" name="session-capture" processRef="Process_session-capture"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_session-capture" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="session-capture" uuid="9ec8c5ec-0635-4e2b-8860-3543220cfeea" version="1" schemaVersion="2" title="session-capture" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="108"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_5_capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_4_emit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_3_uncaptured</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="88"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_2_triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_1_capture</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_session" name="session end / context transition">
      <bpmn:extensionElements>
        <aef:uid value="n_start"/>
        <aef:position x="90.0" y="98.0"/>
        <aef:meta triggeredBy="MANDATORY before: ending session, switching task/topic, significant milestone (AGENT.md:11-15)"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="agt_5_capture" name="capture complete — session may close">
      <bpmn:extensionElements>
        <aef:uid value="n_done"/>
        <aef:position x="930.0" y="98.0"/>
        <aef:meta terminalKind="success" state="capture-complete" note="precondition for session end — 'Do not close without confirming' (AGENT.md:49)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="agt_2_scan" name="scan conversation per category for uncaptured items">
      <bpmn:extensionElements>
        <aef:uid value="n_scan"/>
        <aef:position x="170.0" y="84.0"/>
        <aef:meta tier="1" note="semantic self-scan of the agent's own conversation — inherently stochastic"/>
        <aef:endpoint>AGENT.md:17-37 (category table + checklist scan lines)</aef:endpoint>
        <aef:multiInstance over="categories: work-items, decisions, learnings, questions, gaps" mode="sequential" predicate="signal phrases — should/need-to/TODO/will; choices made; pivots/surprises; open questions; referenced-but-missing" collects="uncaptured[]"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="frw_2_triage" name="triage observation inbox (fw note list)">
      <bpmn:extensionElements>
        <aef:uid value="n_inbox"/>
        <aef:position x="610.0" y="182.0"/>
        <aef:meta tier="1" note="runs regardless of scan outcome — the inbox may hold pre-existing pending notes"/>
        <aef:endpoint>AGENT.md:41-42 (fw note list — promote or dismiss; fw note for new observations)</aef:endpoint>
        <aef:contextReads paths="observation inbox (fw note list)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_4_emit" name="emit capture report (created/updated/practices/questions/gaps)">
      <bpmn:extensionElements>
        <aef:uid value="n_report"/>
        <aef:position x="760.0" y="84.0"/>
        <aef:endpoint>AGENT.md:54-61 (Output section)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="agt_3_uncaptured" name="uncaptured items found?">
      <bpmn:extensionElements>
        <aef:uid value="g_found"/>
        <aef:position x="340.0" y="92.0"/>
        <aef:meta decisionOwner="agent"/>
        <aef:endpoint>AGENT.md:33-37</aef:endpoint>
        <aef:decisionInput>${uncaptured[] not empty}</aef:decisionInput>
        <aef:decisionOutputs>items-found, nothing-uncaptured</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:subProcess id="frw_1_capture" name="capture: tasks, updates, practices, questions">
      <bpmn:extensionElements>
        <aef:uid value="n_capture"/>
        <aef:position x="440.0" y="182.0"/>
        <aef:meta tier="1" note="FC-11 composite — four capture actions, one collapsed subProcess (first-class since T-081)"/>
        <aef:endpoint>AGENT.md:38-40 (checklist capture lines)</aef:endpoint>
        <aef:artifactsWrites paths=".tasks/active/*.md (new + updated), practices, learnings, vision doc"/>
        <aef:constituents>
          <aef:constituent id="c_tasks" name="create task per work item"/>
          <aef:constituent id="c_updates" name="update tasks with new context"/>
          <aef:constituent id="c_practices" name="capture learnings as practices"/>
          <aef:constituent id="c_questions" name="log open questions"/>
        </aef:constituents>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_1_session" targetRef="agt_2_scan">
      <bpmn:extensionElements>
        <aef:uid value="e1"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" sourceRef="agt_2_scan" targetRef="agt_3_uncaptured">
      <bpmn:extensionElements>
        <aef:uid value="e2"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="items found" sourceRef="agt_3_uncaptured" targetRef="frw_1_capture">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">uncaptured not empty</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e3"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" name="nothing uncaptured" sourceRef="agt_3_uncaptured" targetRef="frw_2_triage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">uncaptured empty</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e4"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" sourceRef="frw_1_capture" targetRef="frw_2_triage">
      <bpmn:extensionElements>
        <aef:uid value="e5"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" sourceRef="frw_2_triage" targetRef="agt_4_emit">
      <bpmn:extensionElements>
        <aef:uid value="e6"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" sourceRef="agt_4_emit" targetRef="agt_5_capture">
      <bpmn:extensionElements>
        <aef:uid value="e7"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>