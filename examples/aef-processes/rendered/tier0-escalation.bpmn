<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_tier0-escalation"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_tier0-escalation">
    <bpmn:participant id="Pool_tier0_escalation" name="tier0-escalation" processRef="Process_tier0-escalation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_tier0-escalation" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="tier0-escalation" version="2" schemaVersion="2" title="tier0-escalation" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="160"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>hum_3_abandoned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hum_1_human</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hum_2_approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="240"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_6_executed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_1_pretooluse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_4_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_5_consume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_2_matches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_3_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_7_record</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="200"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_agent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_command</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_agent" name="Agent issues a Bash command">
      <bpmn:extensionElements>
        <aef:uid value="n_propose"/>
        <aef:position x="246.2" y="494.0"/>
        <aef:io>
          <aef:output name="command" type="string"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="frw_6_executed" name="Executed (logged)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_run"/>
        <aef:position x="1402.0" y="324.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="hum_3_abandoned" name="Abandoned (not executed)">
      <bpmn:extensionElements>
        <aef:uid value="n_end_abandoned"/>
        <aef:position x="1402.0" y="130.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="agt_2_command" name="Command executes">
      <bpmn:extensionElements>
        <aef:uid value="n_run"/>
        <aef:position x="966.4" y="480.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="hum_1_human" name="Human reviews — approve or abandon">
      <bpmn:extensionElements>
        <aef:uid value="n_human_decide"/>
        <aef:position x="840.2" y="116.0"/>
        <aef:meta tier="0"/>
        <aef:endpoint>fw tier0 approve  |  Watchtower approval surface</aef:endpoint>
        <aef:decisionOutputs>approve, abandon</aef:decisionOutputs>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:scriptTask id="frw_1_pretooluse" name="PreToolUse hook intercepts (check-tier0.sh)">
      <bpmn:extensionElements>
        <aef:uid value="n_intercept"/>
        <aef:position x="209.2" y="310.0"/>
        <aef:meta tier="0" trigger="PreToolUse:Bash (every command)"/>
        <aef:endpoint>agents/context/check-tier0.sh</aef:endpoint>
        <aef:io>
          <aef:input name="command" type="string" required="true"/>
          <aef:output name="command_hash" type="string"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_4_block" name="BLOCK (exit 2) with explanation">
      <bpmn:extensionElements>
        <aef:uid value="n_block"/>
        <aef:position x="745.0" y="248.0"/>
        <aef:meta tier="0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_5_consume" name="Consume token (single-use) + log approval">
      <bpmn:extensionElements>
        <aef:uid value="n_consume"/>
        <aef:position x="745.0" y="368.0"/>
        <aef:meta tier="0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_7_record" name="Record rejection — resolved(rejected) + feedback">
      <bpmn:extensionElements>
        <aef:uid value="n_record_reject"/>
        <aef:position x="1220.0" y="248.0"/>
        <aef:meta tier="0" note="decide_approval moves pending→resolved for BOTH outcomes; check-tier0.sh reads the rejected record back on retry (T-641). Watchtower reject path only — CLI abandonment writes nothing"/>
        <aef:endpoint>POST /api/approvals/decide (Watchtower)</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="frw_2_matches" name="Matches a destructive pattern?">
      <bpmn:extensionElements>
        <aef:uid value="n_match"/>
        <aef:position x="366.4" y="318.0"/>
        <aef:meta decisionOwner="framework" note="high-confidence PATTERNS (force push, rm -rf /, DROP TABLE, hard reset)"/>
        <aef:decisionInput>${match}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="frw_3_valid" name="Valid single-use approval token?">
      <bpmn:extensionElements>
        <aef:uid value="n_check_approval"/>
        <aef:position x="492.6" y="318.0"/>
        <aef:meta decisionOwner="framework"/>
        <aef:decisionInput>${approved}</aef:decisionInput>
        <aef:constituents>
          <aef:constituent id="c_cli_approval" name="CLI approval token (hash-matched)" ref=".context/working/.tier0-approval (T-1500)"/>
          <aef:constituent id="c_watchtower" name="Watchtower approval record" ref=".context/approvals/ (T-612)"/>
        </aef:constituents>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="hum_2_approve" name="Approve or abandon?">
      <bpmn:extensionElements>
        <aef:uid value="n_route"/>
        <aef:position x="1123.6" y="124.0"/>
        <aef:meta decisionOwner="human"/>
        <aef:decisionInput>${decision}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_1_agent" targetRef="frw_1_pretooluse">
      <bpmn:extensionElements>
        <aef:uid value="e_01"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" sourceRef="frw_1_pretooluse" targetRef="frw_2_matches">
      <bpmn:extensionElements>
        <aef:uid value="e_02"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" name="no match (not consequential)" sourceRef="frw_2_matches" targetRef="agt_2_command">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${match == false}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_03"/>
        <aef:loopDetour y="543.7"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" name="destructive match" sourceRef="frw_2_matches" targetRef="frw_3_valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${match == true}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_04"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" name="valid token" sourceRef="frw_3_valid" targetRef="frw_5_consume">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${approved == true}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_05"/>
        <aef:routingHint role="seg_first" offset="1.3"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" name="no approval" sourceRef="frw_3_valid" targetRef="frw_4_block">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${approved == false}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_06"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" sourceRef="frw_4_block" targetRef="hum_1_human">
      <bpmn:extensionElements>
        <aef:uid value="e_07"/>
        <aef:anchors targetPort="W"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" sourceRef="hum_1_human" targetRef="hum_2_approve">
      <bpmn:extensionElements>
        <aef:uid value="e_08"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" name="approve (fw tier0 approve) + re-issue" sourceRef="hum_2_approve" targetRef="frw_1_pretooluse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${decision == 'approve'}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_09"/>
        <aef:anchors targetPort="N"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" name="abandon" sourceRef="hum_2_approve" targetRef="frw_7_record">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${decision == 'abandon'}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_10"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_11" sourceRef="frw_5_consume" targetRef="agt_2_command">
      <bpmn:extensionElements>
        <aef:uid value="e_11"/>
        <aef:anchors targetPort="N"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_12" sourceRef="agt_2_command" targetRef="frw_6_executed">
      <bpmn:extensionElements>
        <aef:uid value="e_12"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_13" sourceRef="frw_7_record" targetRef="hum_3_abandoned">
      <bpmn:extensionElements>
        <aef:uid value="e_13"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>