<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_inception-lifecycle"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_inception-lifecycle">
    <bpmn:participant id="Pool_inception_lifecycle" name="inception-lifecycle" processRef="Process_inception-lifecycle"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_inception-lifecycle" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="inception-lifecycle" uuid="b726813c-8364-4c2c-b8bd-bf6b16496db8" version="1" schemaVersion="2" title="inception-lifecycle" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="216"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>hum_1_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hum_2_decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="288"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>frw_1_inception</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_9_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_10_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_8_defer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_2_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_3_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_4_generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_6_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_7_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frw_5_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="88"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_conduct</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="frw_1_inception" name="Inception requested">
      <bpmn:extensionElements>
        <aef:uid value="n_req01"/>
        <aef:position x="120.0" y="308.0"/>
        <aef:meta triggeredBy="fw inception start &quot;&lt;name&gt;&quot; --recommendation GO|NO-GO|DEFER"/>
        <aef:io>
          <aef:output name="name" type="string"/>
          <aef:output name="recommendation" type="string"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="frw_9_go" name="GO — build tasks authorized">
      <bpmn:extensionElements>
        <aef:uid value="n_end_go"/>
        <aef:position x="1980.0" y="308.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_10_no" name="NO-GO — parked">
      <bpmn:extensionElements>
        <aef:uid value="n_end_ng"/>
        <aef:position x="1980.0" y="404.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="frw_8_defer" name="DEFER — revisit scheduled">
      <bpmn:extensionElements>
        <aef:uid value="n_end_df"/>
        <aef:position x="1980.0" y="500.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="agt_1_file" name="File recommendation + rationale">
      <bpmn:extensionElements>
        <aef:uid value="n_reco01"/>
        <aef:position x="300.0" y="578.0"/>
        <aef:meta tier="1" agentType="primary"/>
        <aef:endpoint>.agentic-framework/lib/inception.sh:_inject_recommendation_block</aef:endpoint>
        <aef:io>
          <aef:input name="recommendation" type="string" required="true"/>
          <aef:output name="rationale" type="string"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_2_conduct" name="Conduct exploration">
      <bpmn:extensionElements>
        <aef:uid value="n_expl01"/>
        <aef:position x="900.0" y="578.0"/>
        <aef:meta tier="2" agentType="primary"/>
        <aef:endpoint>fw assumption add / research artifact docs/reports/T-XXX-*.md</aef:endpoint>
        <aef:contextReads paths=".tasks/active/${task_id}.md"/>
        <aef:io>
          <aef:output name="research_artifact" type="path"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="hum_1_record" name="Record go/no-go/defer decision">
      <bpmn:extensionElements>
        <aef:uid value="n_dcsn01"/>
        <aef:position x="1320.0" y="84.0"/>
        <aef:meta tier="0"/>
        <aef:endpoint>watchtower:/inception/${task_id}</aef:endpoint>
        <aef:decisionOutputs>go, no-go, defer</aef:decisionOutputs>
        <aef:io>
          <aef:input name="research_artifact" type="path" required="true"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:scriptTask id="frw_2_create" name="Create inception task (status captured)">
      <bpmn:extensionElements>
        <aef:uid value="n_crea01"/>
        <aef:position x="500.0" y="294.0"/>
        <aef:meta tier="1"/>
        <aef:endpoint>agents/task-create/create-task.sh --type inception</aef:endpoint>
        <aef:artifactsWrites paths=".tasks/active/T-XXX.md"/>
        <aef:io>
          <aef:output name="task_id" type="task_id"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_3_start" name="Start work (captured to started-work)">
      <bpmn:extensionElements>
        <aef:uid value="n_strt01"/>
        <aef:position x="700.0" y="294.0"/>
        <aef:meta tier="1"/>
        <aef:endpoint>fw work-on ${task_id}</aef:endpoint>
        <aef:io>
          <aef:input name="task_id" type="task_id" required="true"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_4_generate" name="Generate review surface + marker">
      <bpmn:extensionElements>
        <aef:uid value="n_revw01"/>
        <aef:position x="1100.0" y="294.0"/>
        <aef:meta tier="1"/>
        <aef:endpoint>fw task review ${task_id}</aef:endpoint>
        <aef:artifactsWrites paths=".context/working/.reviewed-${task_id}"/>
        <aef:io>
          <aef:input name="research_artifact" type="path" required="true"/>
        </aef:io>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_6_complete" name="Complete GO — auto-tick ACs, move to completed, authorize build tasks">
      <bpmn:extensionElements>
        <aef:uid value="n_go01"/>
        <aef:position x="1760.0" y="328.0"/>
        <aef:meta tier="1"/>
        <aef:endpoint>fw inception decide ${task_id} go --i-am-human</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_7_complete" name="Complete NO-GO — record + park">
      <bpmn:extensionElements>
        <aef:uid value="n_ng01"/>
        <aef:position x="1760.0" y="404.0"/>
        <aef:meta tier="1"/>
        <aef:endpoint>fw inception decide ${task_id} no-go --i-am-human</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="frw_5_complete" name="Complete DEFER — inject stubs + revisit_at">
      <bpmn:extensionElements>
        <aef:uid value="n_df01"/>
        <aef:position x="1760.0" y="480.0"/>
        <aef:meta tier="1"/>
        <aef:endpoint>fw inception decide ${task_id} defer --i-am-human</aef:endpoint>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="hum_2_decision" name="Decision?">
      <bpmn:extensionElements>
        <aef:uid value="n_rout01"/>
        <aef:position x="1540.0" y="200.0"/>
        <aef:meta decisionOwner="human"/>
        <aef:decisionInput>${decision}</aef:decisionInput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="flow_1" sourceRef="frw_1_inception" targetRef="agt_1_file">
      <bpmn:extensionElements>
        <aef:uid value="e_01"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" sourceRef="agt_1_file" targetRef="frw_2_create">
      <bpmn:extensionElements>
        <aef:uid value="e_02"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" sourceRef="frw_2_create" targetRef="frw_3_start">
      <bpmn:extensionElements>
        <aef:uid value="e_03"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" sourceRef="frw_3_start" targetRef="agt_2_conduct">
      <bpmn:extensionElements>
        <aef:uid value="e_04"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" sourceRef="agt_2_conduct" targetRef="frw_4_generate">
      <bpmn:extensionElements>
        <aef:uid value="e_05"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" sourceRef="frw_4_generate" targetRef="hum_1_record">
      <bpmn:extensionElements>
        <aef:uid value="e_06"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" sourceRef="hum_1_record" targetRef="hum_2_decision">
      <bpmn:extensionElements>
        <aef:uid value="e_07"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" name="go" sourceRef="hum_2_decision" targetRef="frw_6_complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${decision == 'go'}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_08"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" name="no-go" sourceRef="hum_2_decision" targetRef="frw_7_complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${decision == 'no-go'}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_09"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" name="defer" sourceRef="hum_2_decision" targetRef="frw_5_complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${decision == 'defer'}</bpmn:conditionExpression>
      <bpmn:extensionElements>
        <aef:uid value="e_10"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_11" sourceRef="frw_6_complete" targetRef="frw_9_go">
      <bpmn:extensionElements>
        <aef:uid value="e_11"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_12" sourceRef="frw_7_complete" targetRef="frw_10_no">
      <bpmn:extensionElements>
        <aef:uid value="e_12"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_13" sourceRef="frw_5_complete" targetRef="frw_8_defer">
      <bpmn:extensionElements>
        <aef:uid value="e_13"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>