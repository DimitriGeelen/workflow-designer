local_shards_core=4
# T-1481: the pool half of core as core_shards shards over EVERY pool slot (operator 2026-11-22: "use all capacity in the
# pool ... within reasonable risks"): the browser gate and the push gate run one after the other, so the fast slots are
# free while core runs. 7 slots: pool-w1 x2, pool-w2 x2, live-huawei-one x2 (ring20 msg e63a0ff7: admits 832 core),
# pool-132 x1; core there is ~1.2x slower than on pool-w1 (measured 2026-11-22, 391/398 s for 322 leg-s). The unsplit
# shadow goes where the pool puts it (no core_shadow_node line), queued behind the shards. Re-split when browser and core
# run at once (T-1482). Remove core_shards to run core unsplit on the pool again.
core_shards=7
core_shard_nodes="pool-w1 pool-w2 pool-w1 pool-w2 live-huawei-one live-huawei-one pool-132"
